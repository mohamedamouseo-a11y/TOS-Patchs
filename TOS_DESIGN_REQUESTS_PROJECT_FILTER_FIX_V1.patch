+function mergeDesignQueueProjectOptions(current = [], candidates = []) {
+  const byId = new Map();
+
+  for (const project of [...current, ...candidates]) {
+    const id = String(project?.id || "").trim();
+    if (!id || project?.archivedAt) continue;
+
+    const previous = byId.get(id) || {};
+    byId.set(id, {
+      ...previous,
+      ...project,
+      id,
+      name: String(project?.name || previous?.name || id).trim() || id,
+    });
+  }
+
+  return [...byId.values()].sort((left, right) =>
+    String(left?.name || "").localeCompare(String(right?.name || ""), "ar"),
+  );
+}
