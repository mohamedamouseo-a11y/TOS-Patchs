diff --git a/backend/src/agency-operator/tests/ramzySemanticIntent.test.js b/backend/src/agency-operator/tests/ramzySemanticIntent.test.js
new file mode 100644
--- /dev/null
+++ b/backend/src/agency-operator/tests/ramzySemanticIntent.test.js
@@ -0,0 +1,58 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { resolveSemanticIntent } from "../services/semanticIntentResolver.service.js";
+
+const taskContext = {
+  activeTaskId: "task-test-1",
+  recentTasks: [
+    { id: "task-test-1", title: "اختبار", status: "TODO", projectId: "project-test-1" },
+    { id: "task-test-2", title: "اختبار 2", status: "TODO", projectId: "project-test-1" },
+  ],
+  lastResultType: "TASK_LIST",
+  lastResolvedIntent: "TASK_SEARCH",
+};
+
+const statusPhrases = [
+  "حدّث حالة أول واحدة إلى التنفيذ",
+  "حدث حالة أول واحدة إلى التنفيذ",
+  "تحديث حالة أول واحدة إلى التنفيذ",
+  "حدّث الحاله لأول واحدة إلى التنفيذ",
+  "حدّث الحالة لأول واحدة إلى التنفيذ",
+  "غير حالة أول واحدة إلى التنفيذ",
+];
+
+for (const phrase of statusPhrases) {
+  test(`Ramzy recognizes Arabic status update as INTENT_ONLY: ${phrase}`, () => {
+    const result = resolveSemanticIntent({ message: phrase, context: taskContext });
+    assert.equal(result.intent, "TASK_UPDATE");
+    assert.equal(result.operation, "STATUS_CHANGE");
+    assert.equal(result.actionCapability, "INTENT_ONLY");
+    assert.equal(result.slots.statusValue, "IN_PROGRESS");
+  });
+}
+
+test("Ramzy recognizes Arabic priority update spelling variants", () => {
+  const result = resolveSemanticIntent({
+    message: "حدّث الأولوية لأول واحدة إلى عاجل",
+    context: taskContext,
+  });
+  assert.equal(result.intent, "TASK_UPDATE");
+  assert.equal(result.operation, "PRIORITY_CHANGE");
+  assert.equal(result.actionCapability, "INTENT_ONLY");
+  assert.equal(result.slots.priorityValue, "URGENT");
+});
+
+test("Ramzy recognizes Arabic due-date update spelling variants", () => {
+  const result = resolveSemanticIntent({
+    message: "حدّث موعد أول واحدة لبكرة",
+    context: taskContext,
+  });
+  assert.equal(result.intent, "TASK_UPDATE");
+  assert.equal(result.operation, "CHANGE_DUE_DATE");
+  assert.equal(result.actionCapability, "PROPOSAL_SUPPORTED");
+});
