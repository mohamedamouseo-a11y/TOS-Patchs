diff --git a/backend/src/agency-operator/services/ambiguityConfidenceGuard.service.js b/backend/src/agency-operator/services/ambiguityConfidenceGuard.service.js
new file mode 100644
--- /dev/null
+++ b/backend/src/agency-operator/services/ambiguityConfidenceGuard.service.js
@@ -0,0 +1,203 @@
+import { isFuzzyMultilingualMatchType } from "./multilingualMatching.service.js";
+
+const DECISIONS = Object.freeze({
+  AUTO_RESOLVE: "AUTO_RESOLVE",
+  CLARIFY: "CLARIFY",
+  REJECT: "REJECT",
+});
+
+const ENTITY_PROFILES = Object.freeze({
+  PROJECT: { ambiguityDelta: 0.08, tieAutoResolveThreshold: 0.9 },
+  USER: { ambiguityDelta: 0.05, tieAutoResolveThreshold: 0.95 },
+  TASK: { ambiguityDelta: 0.05, tieAutoResolveThreshold: 0.95 },
+  GENERIC: { ambiguityDelta: 0.08, tieAutoResolveThreshold: 0.9 },
+});
+
+const MATCH_MIN_CONFIDENCE = Object.freeze({
+  EXPLICIT_ID: 1,
+  EXACT: 1,
+  ALIAS: 0.95,
+  PREFIX: 0.9,
+  CONTAINS: 0.82,
+  TOKEN_OVERLAP: 0.78,
+  TRANSLITERATION: 0.84,
+  TRANSLITERATION_FUZZY: 0.82,
+  PHONETIC_EQUIVALENT: 0.84,
+  PHONETIC_FUZZY: 0.82,
+  FUZZY_TYPO: 0.82,
+});
+
+function entityProfile(entityType) {
+  return ENTITY_PROFILES[String(entityType || "GENERIC").toUpperCase()] || ENTITY_PROFILES.GENERIC;
+}
+
+function confidenceBand(value) {
+  const score = Number(value || 0);
+  if (score >= 0.95) return "VERY_HIGH";
+  if (score >= 0.9) return "HIGH";
+  if (score >= 0.82) return "MEDIUM";
+  if (score > 0) return "LOW";
+  return "NONE";
+}
+
+function guardResult({ decision, reason, entityType, confidence = 0, matchType = "NONE", candidates = [], closeCandidates = [] }) {
+  return {
+    version: "RAMZY_AMBIGUITY_CONFIDENCE_GUARD_V1",
+    decision,
+    reason,
+    entityType: String(entityType || "GENERIC").toUpperCase(),
+    confidence: Number(confidence || 0),
+    confidenceBand: confidenceBand(confidence),
+    matchType: String(matchType || "NONE"),
+    candidateCount: Array.isArray(candidates) ? candidates.length : 0,
+    closeCandidateCount: Array.isArray(closeCandidates) ? closeCandidates.length : 0,
+  };
+}
+
+export function evaluateResolutionGuard({
+  entityType = "GENERIC",
+  explicitId = null,
+  explicitIdFound = false,
+  matchType = "NONE",
+  confidence = 0,
+  candidates = [],
+  exactMatches = [],
+  ambiguityDelta = null,
+  tieAutoResolveThreshold = null,
+} = {}) {
+  const profile = entityProfile(entityType);
+  const delta = Number.isFinite(Number(ambiguityDelta)) ? Number(ambiguityDelta) : profile.ambiguityDelta;
+  const tieThreshold = Number.isFinite(Number(tieAutoResolveThreshold)) ? Number(tieAutoResolveThreshold) : profile.tieAutoResolveThreshold;
+
+  if (explicitId) {
+    return guardResult({
+      decision: explicitIdFound ? DECISIONS.AUTO_RESOLVE : DECISIONS.REJECT,
+      reason: explicitIdFound ? "EXPLICIT_ID_CONFIRMED" : "ID_NOT_FOUND",
+      entityType,
+      confidence: explicitIdFound ? 1 : 0,
+      matchType: explicitIdFound ? "EXPLICIT_ID" : "NONE",
+      candidates: explicitIdFound ? candidates : [],
+    });
+  }
+
+  if (!Array.isArray(candidates) || !candidates.length) {
+    return guardResult({ decision: DECISIONS.REJECT, reason: "NO_MATCH", entityType, confidence: 0, matchType: "NONE" });
+  }
+
+  if (Array.isArray(exactMatches) && exactMatches.length > 1) {
+    return guardResult({
+      decision: DECISIONS.CLARIFY,
+      reason: "EXACT_DUPLICATE",
+      entityType,
+      confidence: 1,
+      matchType: "EXACT",
+      candidates: exactMatches,
+      closeCandidates: exactMatches,
+    });
+  }
+
+  const top = candidates[0];
+  const topConfidence = Number(confidence || top?.score || 0);
+  const topMatchType = String(matchType || top?.matchType || "NONE");
+  const close = candidates.filter((candidate) => topConfidence - Number(candidate?.score || 0) < delta);
+
+  if (isFuzzyMultilingualMatchType(topMatchType) && close.length > 1) {
+    return guardResult({
+      decision: DECISIONS.CLARIFY,
+      reason: "FUZZY_MULTILINGUAL_TIE",
+      entityType,
+      confidence: topConfidence,
+      matchType: topMatchType,
+      candidates,
+      closeCandidates: close,
+    });
+  }
+
+  if (close.length > 1 && topConfidence < tieThreshold) {
+    return guardResult({
+      decision: DECISIONS.CLARIFY,
+      reason: "LOW_CONFIDENCE_TIE",
+      entityType,
+      confidence: topConfidence,
+      matchType: topMatchType,
+      candidates,
+      closeCandidates: close,
+    });
+  }
+
+  const minimum = MATCH_MIN_CONFIDENCE[topMatchType] ?? 0.82;
+  if (topConfidence < minimum) {
+    return guardResult({
+      decision: DECISIONS.CLARIFY,
+      reason: "LOW_CONFIDENCE_SINGLE",
+      entityType,
+      confidence: topConfidence,
+      matchType: topMatchType,
+      candidates,
+      closeCandidates: [top],
+    });
+  }
+
+  return guardResult({
+    decision: DECISIONS.AUTO_RESOLVE,
+    reason: "CONFIDENCE_POLICY_PASSED",
+    entityType,
+    confidence: topConfidence,
+    matchType: topMatchType,
+    candidates,
+    closeCandidates: [top],
+  });
+}
+
+function compactTaskCandidates(previous) {
+  const recent = Array.isArray(previous?.recentTasks) ? previous.recentTasks : [];
+  return recent.filter((item) => item?.id).slice(0, 15).map((item) => ({
+    id: item.id,
+    title: String(item.title || "").slice(0, 240),
+    status: item.status || null,
+    projectId: item.projectId || null,
+  }));
+}
+
+export function evaluateTaskActionTargetGuard({
+  detectedIntent,
+  semanticOperation = null,
+  previous = {},
+  contextResolution = {},
+  assigneeResolution = null,
+} = {}) {
+  const actionRequired = detectedIntent === "TASK_UPDATE";
+  if (!actionRequired) {
+    return {
+      version: "RAMZY_AMBIGUITY_CONFIDENCE_GUARD_V1",
+      required: false,
+      decision: DECISIONS.AUTO_RESOLVE,
+      reason: "ACTION_TARGET_NOT_REQUIRED",
+      entityType: "TASK",
+      targetTaskId: null,
+      candidates: [],
+    };
+  }
+
+  const tasks = compactTaskCandidates(previous);
+  let targetTaskId = contextResolution?.referencedTaskId || null;
+  if (!targetTaskId && tasks.length === 1) targetTaskId = tasks[0].id;
+  if (!targetTaskId && previous?.lastResultType === "TASK" && previous?.activeTaskId) targetTaskId = previous.activeTaskId;
+
+  if (!targetTaskId) {
+    return {
+      version: "RAMZY_AMBIGUITY_CONFIDENCE_GUARD_V1",
+      required: true,
+      decision: DECISIONS.CLARIFY,
+      reason: tasks.length > 1 ? "TASK_TARGET_AMBIGUOUS" : "TASK_TARGET_REQUIRED",
+      entityType: "TASK",
+      targetTaskId: null,
+      candidates: tasks,
+    };
+  }
+
+  if (semanticOperation === "CHANGE_ASSIGNEE") {
+    if (!assigneeResolution) {
+      return {
+        version: "RAMZY_AMBIGUITY_CONFIDENCE_GUARD_V1",
+        required: true,
+        decision: DECISIONS.CLARIFY,
+        reason: "USER_TARGET_REQUIRED",
+        entityType: "USER",
+        targetTaskId,
+        candidates: [],
+      };
+    }
+    if (assigneeResolution.guardDecision && assigneeResolution.guardDecision !== DECISIONS.AUTO_RESOLVE) {
+      return {
+        version: "RAMZY_AMBIGUITY_CONFIDENCE_GUARD_V1",
+        required: true,
+        decision: assigneeResolution.guardDecision,
+        reason: assigneeResolution.guardReason || "USER_TARGET_UNRESOLVED",
+        entityType: "USER",
+        targetTaskId,
+        candidates: (assigneeResolution.candidates || []).slice(0, 8),
+      };
+    }
+  }
+
+  return {
+    version: "RAMZY_AMBIGUITY_CONFIDENCE_GUARD_V1",
+    required: true,
+    decision: DECISIONS.AUTO_RESOLVE,
+    reason: "ACTION_TARGET_UNIQUE",
+    entityType: "TASK",
+    targetTaskId,
+    candidates: tasks.filter((item) => item.id === targetTaskId),
+  };
+}
+
+export function getAmbiguityConfidenceGuardConfig() {
+  return {
+    version: "RAMZY_AMBIGUITY_CONFIDENCE_GUARD_V1",
+    decisions: Object.values(DECISIONS),
+    entityProfiles: ENTITY_PROFILES,
+    matchMinimumConfidence: MATCH_MIN_CONFIDENCE,
+    providerCalls: 0,
+  };
+}
