+export async function getShadowRequesterScope(requester) {
+  const requesterId = String(requester?.id || "").trim();
+  const rawDepartment = String(requester?.department || "").trim();
+  const personalDepartment = normalizeDepartmentName(rawDepartment) || rawDepartment || null;
+
+  const managedUnits = requesterId
+    ? await prisma.departmentUnit.findMany({
+        where: {
+          isActive: true,
+          OR: [{ managerId: requesterId }, { deputyManagerId: requesterId }],
+        },
+        orderBy: [{ sortOrder: "asc" }, { name: "asc" }],
+        select: { name: true, managerId: true, deputyManagerId: true },
+      })
+    : [];
+
+  const managedDepartmentNames = Array.from(new Set(
+    managedUnits
+      .map((unit) => normalizeDepartmentName(unit.name) || String(unit.name || "").trim())
+      .filter(Boolean),
+  ));
+  const departmentNames = managedDepartmentNames.length
+    ? managedDepartmentNames
+    : (personalDepartment ? [personalDepartment] : []);
+
+  const departmentUnits = departmentNames.length
+    ? await prisma.departmentUnit.findMany({
+        where: { isActive: true, name: { in: departmentNames } },
+        select: { managerId: true, deputyManagerId: true },
+      })
+    : [];
+  const leadershipIds = Array.from(new Set(
+    departmentUnits
+      .flatMap((unit) => [unit.managerId, unit.deputyManagerId])
+      .map((value) => String(value || "").trim())
+      .filter(Boolean),
+  ));
+
+  return {
+    departmentNames,
+    managedDepartmentNames,
+    leadershipIds,
+    isLeader: managedDepartmentNames.length > 0,
+    exempt: departmentNames.length > 0 && departmentNames.every(isShadowingExemptDepartment),
+  };
+}
+
+export async function getShadowCandidates(requester, period = {}, { excludeRequestId = null, includeAvailability = false } = {}) {
+  if (!requester?.id) return [];
+
+  const scope = await getShadowRequesterScope(requester);
+  if (!scope.departmentNames.length || scope.exempt) return [];
+
+  const users = await prisma.user.findMany({
+    where: {
+      id: { not: requester.id },
+      status: "ACTIVE",
+      role: { in: STAFF_ROLES },
+      OR: [
+        { department: { in: scope.departmentNames } },
+        ...(scope.leadershipIds.length ? [{ id: { in: scope.leadershipIds } }] : []),
+      ],
+    },
+    orderBy: [{ role: "asc" }, { name: "asc" }, { email: "asc" }],
+    select: { id: true, name: true, email: true, role: true, department: true, avatarUrl: true },
+    take: 200,
+  });
+
+  if (!includeAvailability || !period?.startDate) return users.map(safeCandidate);
+  const conflicts = await conflictingRequestsForCandidates(users.map((user) => user.id), period, excludeRequestId);
+  return users.map((user) => {
+    const conflict = conflicts.get(user.id) || null;
+    return {
+      ...safeCandidate(user),
+      available: !conflict,
+      conflictRequestId: conflict?.id || null,
+      conflictReason: conflict ? (conflict.requesterId === user.id ? "EMPLOYEE_ABSENCE" : "ALREADY_COVERING") : null,
+    };
+  });
+}
+
+export async function assertShadowCandidateAvailable(requester, candidateId, period = {}, { excludeRequestId = null } = {}) {
+  const id = String(candidateId || "").trim();
+  if (!id) throw new AppError("Shadow member is required", 400);
+  if (id === requester?.id) throw new AppError("You cannot select yourself as the shadow member", 400);
+
+  const scope = await getShadowRequesterScope(requester);
+  if (!scope.departmentNames.length || scope.exempt) {
+    throw new AppError("No shadowing department is available for this employee", 400);
+  }
+
+  const candidate = await prisma.user.findFirst({
+    where: {
+      id,
+      status: "ACTIVE",
+      role: { in: STAFF_ROLES },
+      OR: [
+        { department: { in: scope.departmentNames } },
+        ...(scope.leadershipIds.length ? [{ id: { in: scope.leadershipIds } }] : []),
+      ],
+    },
+    select: { id: true, name: true, email: true, role: true, department: true, avatarUrl: true },
+  });
+  if (!candidate) throw new AppError("The selected shadow member must be an active employee in your eligible department scope", 400);
+
+  const conflict = await conflictingRequestForCandidate(candidate.id, period, excludeRequestId);
+  if (conflict) {
+    throw new AppError(
+      conflict.requesterId === candidate.id
+        ? "The selected shadow member has an overlapping leave or permission request"
+        : "The selected shadow member is already covering another employee during this period",
+      400,
+    );
+  }
+  return safeCandidate(candidate);
+}
 
