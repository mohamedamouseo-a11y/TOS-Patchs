new file mode 100644
--- /dev/null
+++ b/backend/src/agency-operator/services/actionGroundingValidation.service.js
@@ -0,0 +1,286 @@
+import { prisma } from "../../prisma.js";
+import { assertAssigneeInProject } from "../../middleware/auth.js";
+import { canActorAssignTargetUser } from "../../services/projectAccessScope.service.js";
+import { assertAgentTaskActionAccess } from "../policies/agentAccess.service.js";
+
+const SUPPORTED_PROPOSAL_OPERATIONS = new Set([
+  "ADD_COMMENT",
+  "ADD_CHECKLIST",
+  "CHANGE_DUE_DATE",
+  "CHANGE_ASSIGNEE",
+]);
+
+const CAPABILITIES = Object.freeze({
+  READ: "READ",
+  PROPOSAL_SUPPORTED: "PROPOSAL_SUPPORTED",
+  INTENT_ONLY: "INTENT_ONLY",
+});
+
+const DECISIONS = Object.freeze({
+  PASS: "PASS",
+  CLARIFY: "CLARIFY",
+  REJECT: "REJECT",
+});
+
+const REQUIRED_PAYLOAD_FIELDS = Object.freeze({
+  ADD_COMMENT: ["body"],
+  ADD_CHECKLIST: ["title"],
+  CHANGE_DUE_DATE: ["dueDate"],
+  CHANGE_ASSIGNEE: ["assigneeId"],
+});
+
+function normalizedOperation(value) {
+  return String(value || "").trim().toUpperCase() || null;
+}
+
+function errorStatus(error) {
+  return Number(error?.status || error?.statusCode || 0);
+}
+
+function compactErrorReason(error, fallback = "ACTION_ACCESS_REJECTED") {
+  const status = errorStatus(error);
+  if (status === 404) return "TASK_NOT_FOUND";
+  if (status === 401 || status === 403) return "ACTION_ACCESS_DENIED";
+  if (status === 400) return "ACTION_VALIDATION_REJECTED";
+  return fallback;
+}
+
+function result({
+  capability,
+  decision,
+  reason,
+  operation = null,
+  providerAllowed = false,
+  proposalAllowed = false,
+  targetTaskId = null,
+  targetTaskTitle = null,
+  targetProjectId = null,
+  groundedAssigneeId = null,
+  groundedAssigneeName = null,
+  requiredPayloadFields = [],
+  userMessage = null,
+}) {
+  return {
+    version: "RAMZY_ACTION_GROUNDING_VALIDATION_V1",
+    capability,
+    decision,
+    reason,
+    operation,
+    providerAllowed: Boolean(providerAllowed),
+    proposalAllowed: Boolean(proposalAllowed),
+    targetTaskId,
+    targetTaskTitle,
+    targetProjectId,
+    groundedAssigneeId,
+    groundedAssigneeName,
+    requiredPayloadFields,
+    payloadValidationMode: proposalAllowed ? "TOOL_BOUNDARY_AND_TASK_COMMAND" : "NONE",
+    executionMode: proposalAllowed ? "PROPOSAL_ONLY" : "NO_EXECUTION",
+  };
+}
+
+export function classifyActionCapability(intentResolution = {}) {
+  const operation = normalizedOperation(intentResolution?.operation);
+  const semanticCapability = String(intentResolution?.actionCapability || "").toUpperCase();
+  const intent = String(intentResolution?.intent || "GENERAL").toUpperCase();
+
+  if (semanticCapability === CAPABILITIES.PROPOSAL_SUPPORTED && SUPPORTED_PROPOSAL_OPERATIONS.has(operation)) {
+    return CAPABILITIES.PROPOSAL_SUPPORTED;
+  }
+  if (operation || intent === "TASK_CREATE" || intent === "TASK_UPDATE" || semanticCapability === CAPABILITIES.INTENT_ONLY) {
+    return CAPABILITIES.INTENT_ONLY;
+  }
+  return CAPABILITIES.READ;
+}
+
+export function actionGroundingUserMessage(grounding = {}) {
+  const operation = normalizedOperation(grounding.operation);
+  if (grounding.capability === CAPABILITIES.INTENT_ONLY) {
+    if (operation === "STATUS_CHANGE") return "فاهم إنك عايز تغيّر حالة المهمة، لكن رمزي حاليًا ما بيدعمش اقتراح تغيير الحالة. مفيش أي تعديل اتنفذ.";
+    if (operation === "PRIORITY_CHANGE") return "فاهم إنك عايز تغيّر أولوية المهمة، لكن رمزي حاليًا ما بيدعمش اقتراح تغيير الأولوية. مفيش أي تعديل اتنفذ.";
+    if (operation === "CREATE_TASK") return "فاهم إنك عايز تنشئ مهمة، لكن رمزي في الإصدار الحالي ما بينشئش مهام مباشرة. مفيش أي مهمة اتعملت.";
+    return "فاهم التعديل المطلوب، لكن النوع ده من التعديلات مش مدعوم حاليًا في إجراءات رمزي. مفيش أي تغيير اتنفذ.";
+  }
+  if (grounding.reason === "ACTION_ACCESS_DENIED") return "المهمة موجودة، لكن التعديل المطلوب خارج صلاحياتك الحالية. مفيش أي تغيير اتنفذ.";
+  if (grounding.reason === "TASK_NOT_FOUND") return "مقدرتش أثبّت المهمة المطلوبة داخل نطاق صلاحياتك، لذلك ما جهزتش أي تعديل.";
+  if (["ASSIGNEE_NOT_IN_PROJECT", "ASSIGNEE_NOT_ASSIGNABLE", "ASSIGNEE_INACTIVE"].includes(grounding.reason)) {
+    return "الموظف المحدد مش هدف صالح للإسناد على المهمة دي ضمن صلاحياتك الحالية، لذلك ما جهزتش أي تعديل.";
+  }
+  if (grounding.decision === DECISIONS.REJECT) return "مقدرتش أثبّت الإجراء المطلوب بشكل آمن، لذلك ما جهزتش أي تعديل.";
+  return null;
+}
+
+export async function evaluateActionGrounding({
+  user,
+  intentResolution = {},
+  actionTargetGuard = {},
+  assigneeResolution = null,
+  allowedWorkspaceIds = [],
+} = {}) {
+  const capability = classifyActionCapability(intentResolution);
+  const operation = normalizedOperation(intentResolution?.operation);
+
+  if (capability === CAPABILITIES.READ) {
+    return result({
+      capability,
+      decision: DECISIONS.PASS,
+      reason: "READ_INTENT_NO_ACTION_GROUNDING_REQUIRED",
+      operation,
+      providerAllowed: true,
+      proposalAllowed: false,
+    });
+  }
+
+  if (capability === CAPABILITIES.INTENT_ONLY || !SUPPORTED_PROPOSAL_OPERATIONS.has(operation)) {
+    const grounding = result({
+      capability: CAPABILITIES.INTENT_ONLY,
+      decision: DECISIONS.REJECT,
+      reason: "OPERATION_NOT_SUPPORTED",
+      operation,
+      providerAllowed: false,
+      proposalAllowed: false,
+    });
+    return { ...grounding, userMessage: actionGroundingUserMessage(grounding) };
+  }
+
+  if (actionTargetGuard?.decision && actionTargetGuard.decision !== "AUTO_RESOLVE") {
+    return result({
+      capability,
+      decision: DECISIONS.CLARIFY,
+      reason: actionTargetGuard.reason || "TASK_TARGET_UNRESOLVED",
+      operation,
+      providerAllowed: false,
+      proposalAllowed: false,
+      targetTaskId: actionTargetGuard.targetTaskId || null,
+      requiredPayloadFields: REQUIRED_PAYLOAD_FIELDS[operation] || [],
+    });
+  }
+
+  const targetTaskId = String(actionTargetGuard?.targetTaskId || "").trim() || null;
+  if (!targetTaskId) {
+    return result({
+      capability,
+      decision: DECISIONS.CLARIFY,
+      reason: "TASK_TARGET_REQUIRED",
+      operation,
+      providerAllowed: false,
+      proposalAllowed: false,
+      requiredPayloadFields: REQUIRED_PAYLOAD_FIELDS[operation] || [],
+    });
+  }
+
+  let task;
+  try {
+    ({ task } = await assertAgentTaskActionAccess(
+      user,
+      targetTaskId,
+      operation,
+      allowedWorkspaceIds,
+      prisma,
+    ));
+  } catch (error) {
+    const grounding = result({
+      capability,
+      decision: DECISIONS.REJECT,
+      reason: compactErrorReason(error),
+      operation,
+      providerAllowed: false,
+      proposalAllowed: false,
+      targetTaskId,
+      requiredPayloadFields: REQUIRED_PAYLOAD_FIELDS[operation] || [],
+    });
+    return { ...grounding, userMessage: actionGroundingUserMessage(grounding) };
+  }
+
+  let groundedAssigneeId = null;
+  let groundedAssigneeName = null;
+  if (operation === "CHANGE_ASSIGNEE") {
+    groundedAssigneeId = String(assigneeResolution?.entity?.id || "").trim() || null;
+    if (!groundedAssigneeId) {
+      return result({
+        capability,
+        decision: DECISIONS.CLARIFY,
+        reason: "ASSIGNEE_TARGET_REQUIRED",
+        operation,
+        providerAllowed: false,
+        proposalAllowed: false,
+        targetTaskId: task.id,
+        targetTaskTitle: task.title || null,
+        targetProjectId: task.projectId || null,
+        requiredPayloadFields: REQUIRED_PAYLOAD_FIELDS[operation],
+      });
+    }
+
+    try {
+      await assertAssigneeInProject(task.projectId, groundedAssigneeId);
+    } catch {
+      const grounding = result({
+        capability,
+        decision: DECISIONS.REJECT,
+        reason: "ASSIGNEE_NOT_IN_PROJECT",
+        operation,
+        providerAllowed: false,
+        proposalAllowed: false,
+        targetTaskId: task.id,
+        targetTaskTitle: task.title || null,
+        targetProjectId: task.projectId || null,
+        groundedAssigneeId,
+        requiredPayloadFields: REQUIRED_PAYLOAD_FIELDS[operation],
+      });
+      return { ...grounding, userMessage: actionGroundingUserMessage(grounding) };
+    }
+
+    const target = await prisma.user.findFirst({
+      where: { id: groundedAssigneeId, status: "ACTIVE" },
+      select: { id: true, name: true, email: true, role: true, status: true, department: true },
+    });
+    if (!target) {
+      const grounding = result({
+        capability,
+        decision: DECISIONS.REJECT,
+        reason: "ASSIGNEE_INACTIVE",
+        operation,
+        providerAllowed: false,
+        proposalAllowed: false,
+        targetTaskId: task.id,
+        targetTaskTitle: task.title || null,
+        targetProjectId: task.projectId || null,
+        groundedAssigneeId,
+        requiredPayloadFields: REQUIRED_PAYLOAD_FIELDS[operation],
+      });
+      return { ...grounding, userMessage: actionGroundingUserMessage(grounding) };
+    }
+    if (!(await canActorAssignTargetUser(user, target, prisma))) {
+      const grounding = result({
+        capability,
+        decision: DECISIONS.REJECT,
+        reason: "ASSIGNEE_NOT_ASSIGNABLE",
+        operation,
+        providerAllowed: false,
+        proposalAllowed: false,
+        targetTaskId: task.id,
+        targetTaskTitle: task.title || null,
+        targetProjectId: task.projectId || null,
+        groundedAssigneeId,
+        groundedAssigneeName: target.name || target.email || null,
+        requiredPayloadFields: REQUIRED_PAYLOAD_FIELDS[operation],
+      });
+      return { ...grounding, userMessage: actionGroundingUserMessage(grounding) };
+    }
+    groundedAssigneeName = target.name || target.email || null;
+  }
+
+  return result({
+    capability,
+    decision: DECISIONS.PASS,
+    reason: "ACTION_GROUNDED_AND_AUTHORIZED",
+    operation,
+    providerAllowed: true,
+    proposalAllowed: true,
+    targetTaskId: task.id,
+    targetTaskTitle: task.title || null,
+    targetProjectId: task.projectId || null,
+    groundedAssigneeId,
+    groundedAssigneeName,
+    requiredPayloadFields: REQUIRED_PAYLOAD_FIELDS[operation] || [],
+  });
+}
+
+function payloadObject(value) {
+  return value && typeof value === "object" && !Array.isArray(value) ? value : {};
+}
+
+export function validateProposalToolInputAgainstGrounding({ actionGrounding = null, input = {} } = {}) {
+  if (!actionGrounding || actionGrounding.version !== "RAMZY_ACTION_GROUNDING_VALIDATION_V1") {
+    return { allowed: false, reason: "GROUNDING_CONTEXT_MISSING" };
+  }
+  if (!actionGrounding.proposalAllowed || actionGrounding.decision !== DECISIONS.PASS) {
+    return { allowed: false, reason: "PROPOSAL_NOT_GROUNDED" };
+  }
+  const actionType = normalizedOperation(input.actionType);
+  const taskId = String(input.taskId || "").trim();
+  if (actionType !== actionGrounding.operation) return { allowed: false, reason: "ACTION_TYPE_MISMATCH" };
+  if (!taskId || taskId !== actionGrounding.targetTaskId) return { allowed: false, reason: "TASK_TARGET_MISMATCH" };
+
+  const payload = payloadObject(input.payload);
+  if (actionType === "ADD_COMMENT" && !String(payload.body || "").trim()) return { allowed: false, reason: "COMMENT_BODY_REQUIRED" };
+  if (actionType === "ADD_CHECKLIST" && !String(payload.title || "").trim()) return { allowed: false, reason: "CHECKLIST_TITLE_REQUIRED" };
+  if (actionType === "CHANGE_DUE_DATE" && payload.dueDate !== null && payload.dueDate !== "") {
+    const dueDate = new Date(payload.dueDate);
+    if (Number.isNaN(dueDate.getTime())) return { allowed: false, reason: "DUE_DATE_INVALID" };
+  }
+  if (actionType === "CHANGE_ASSIGNEE") {
+    const assigneeId = String(payload.assigneeId || "").trim();
+    if (!assigneeId) return { allowed: false, reason: "ASSIGNEE_ID_REQUIRED" };
+    if (!actionGrounding.groundedAssigneeId || assigneeId !== actionGrounding.groundedAssigneeId) {
+      return { allowed: false, reason: "ASSIGNEE_TARGET_MISMATCH" };
+    }
+  }
+  return { allowed: true, reason: "GROUNDED_PROPOSAL_INPUT_VALID" };
+}
+
+export function getActionGroundingValidationConfig() {
+  return {
+    version: "RAMZY_ACTION_GROUNDING_VALIDATION_V1",
+    capabilities: Object.values(CAPABILITIES),
+    decisions: Object.values(DECISIONS),
+    supportedProposalOperations: [...SUPPORTED_PROPOSAL_OPERATIONS],
+    requiredPayloadFields: REQUIRED_PAYLOAD_FIELDS,
+    proposalOnly: true,
+    providerCalls: 0,
+  };
+}
