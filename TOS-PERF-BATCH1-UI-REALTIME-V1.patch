+    if (lang !== "en") {
+      restoreElementText(root);
+      restoreAttributes(root);
+      return undefined;
+    }
+
+    translateElementText(root);
+    translateElementAttributes(root);
+
+    let frameId = 0;
+    const pendingRoots = new Set();
+    const flushPending = () => {
+      frameId = 0;
+      const roots = Array.from(pendingRoots);
+      pendingRoots.clear();
+      roots.forEach((element) => {
+        translateElementText(element);
+        translateElementAttributes(element);
+      });
+    };
+    const queueNode = (node) => {
+      const element = node?.nodeType === 3 ? node.parentElement : node?.nodeType === 1 ? node : null;
+      if (!element) return;
+      pendingRoots.add(element);
+      if (!frameId) frameId = requestAnimationFrame(flushPending);
+    };
