+
+function translateElementAttributes(root) {
+  const attrs = ["placeholder", "aria-label", "title", "alt"];
+  const selector = attrs.map((attr) => `[${attr}]`).join(",");
+  matchingElements(root, selector).forEach((element) => {
+    attrs.forEach((attr) => {
+      const value = element.getAttribute(attr);
+      if (!value || !hasArabic(value)) return;
+      const dataKey = `i18nOriginal${attr.replace(/(^|-)([a-z])/g, (_, _dash, ch) => ch.toUpperCase())}`;
