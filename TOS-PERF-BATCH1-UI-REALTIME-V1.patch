+
+function translateElementText(root) {
+  matchingElements(root).forEach((element) => {
+    if (["SCRIPT", "STYLE", "TEXTAREA", "INPUT", "SELECT"].includes(element.tagName)) return;
+    if (element.children.length > 0) return;
