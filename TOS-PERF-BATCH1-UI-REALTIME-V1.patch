+      const next = translateArabicText(value);
+      if (next !== value) element.setAttribute(attr, next);
+    });
+  });
+}
+
+function restoreAttributes(root) {
+  const attrs = ["placeholder", "aria-label", "title", "alt"];
+  matchingElements(root).forEach((element) => {
+    attrs.forEach((attr) => {
+      const dataKey = `i18nOriginal${attr.replace(/(^|-)([a-z])/g, (_, _dash, ch) => ch.toUpperCase())}`;
+      const original = element.dataset?.[dataKey];
+      if (original) {
+        element.setAttribute(attr, original);
+        delete element.dataset[dataKey];
+      }
+    });
