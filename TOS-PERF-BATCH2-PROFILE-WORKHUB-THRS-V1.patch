+
+export async function serializeEmployeeWorkRequestsForViewer(rows = [], actorTokenUser = null) {
+  const actor = actorTokenUser?.status ? actorTokenUser : await getFullUser(actorTokenUser?.id);
+  if (!actor || actor.status !== "ACTIVE" || !STAFF_ROLES.has(actor.role)) throw new AppError("Staff account was not found", 403);
+  return enrich(rows, actor);
+}
+
+export async function getEmployeeWorkRequestsForProfile(actorTokenUser, profileUserId) {
+  if (!hasRequestModel()) return [];
+  if (!isTosStaffRole(actorTokenUser?.role)) throw new AppError("Employee Work Hub is available for staff accounts only.", 403);
+
+  const actor = await getFullUser(actorTokenUser.id);
+  if (!actor || actor.status !== "ACTIVE" || !STAFF_ROLES.has(actor.role)) throw new AppError("Staff account was not found", 403);
+
+  const targetUserId = cleanText(profileUserId, 120);
+  if (!targetUserId) throw new AppError("profile user id is required", 400);
+  if (targetUserId !== actor.id && !["SUPER_ADMIN", "ADMIN"].includes(actor.role)) {
+    throw new AppError("You are not allowed to view this employee request history", 403);
+  }
+
+  const rows = await prisma.employeeWorkRequest.findMany({
+    where: { requesterId: targetUserId },
+    orderBy: { createdAt: "desc" },
+    take: 300,
+  });
+  return enrich(rows, actor);
+}
 
