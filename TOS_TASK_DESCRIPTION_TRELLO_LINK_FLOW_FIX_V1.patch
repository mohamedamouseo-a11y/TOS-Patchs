+
+    const plainLink = document.createElement("a");
+    plainLink.href = href;
+    plainLink.target = "_blank";
+    plainLink.rel = "noopener noreferrer";
+    plainLink.className = "tos-task-description-link not-prose text-blue-600 underline underline-offset-2 dark:text-blue-300";
+    plainLink.textContent = href;
+    plainLink.setAttribute("dir", "ltr");
