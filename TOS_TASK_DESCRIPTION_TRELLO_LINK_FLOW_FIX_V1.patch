+    plainLink.style.width = "fit-content";
+    plainLink.style.maxWidth = "100%";
+    plainLink.style.margin = "0.25rem 0";
+    plainLink.style.overflowWrap = "anywhere";
+    plainLink.style.wordBreak = "break-word";
+    plainLink.style.unicodeBidi = "plaintext";
+
+    chip.replaceWith(plainLink);
+    changed = true;
+  });
+
+  return changed;
+}
+
