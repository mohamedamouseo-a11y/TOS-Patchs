+    if (!plainBlockLinks) enhanceSmartLinkTitles(root, undefined, ui);
+  }, [safeHtml, ui, designBriefFiles, plainBlockLinks]);
 
   return <div ref={contentRef} className={className} onClick={openRichTextLink} dangerouslySetInnerHTML={{ __html: safeHtml }} />;
 }
 
