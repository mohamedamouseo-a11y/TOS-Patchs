diff --git a/frontend/src/index.css b/frontend/src/index.css
--- a/frontend/src/index.css
+++ b/frontend/src/index.css
@@ -6229,5 +6229,48 @@
 @media(max-width:640px){
   .ramzy-markdown-table-wrap table{min-width:360px}
   .ramzy-result-card{grid-template-columns:repeat(2,minmax(0,1fr));padding:9px 10px}
   .ramzy-composer textarea{height:48px;min-height:48px}
 }
+/* TOS_RAMZY_LIGHT_PREMIUM_3D_V1 — CSS-only. Ramzy image/src intentionally untouched. */
+.ramzy-panel{isolation:isolate;border:1px solid rgba(124,58,237,.12);background:radial-gradient(circle at 82% -8%,rgba(196,181,253,.3),transparent 34%),radial-gradient(circle at 8% 104%,rgba(251,191,36,.08),transparent 30%),linear-gradient(145deg,rgba(255,255,255,.985),rgba(250,248,255,.965) 56%,rgba(255,253,249,.975));color:#1f1b2d;box-shadow:0 38px 90px rgba(68,55,120,.16),0 16px 36px rgba(30,41,59,.08),inset 0 1px 0 #fff,inset 0 -1px 0 rgba(124,58,237,.05);backdrop-filter:blur(24px) saturate(1.12);-webkit-backdrop-filter:blur(24px) saturate(1.12)}
+.ramzy-panel::before{content:"";position:absolute;z-index:0;inset:0 0 auto;height:9px;border-radius:30px 30px 0 0;background:linear-gradient(90deg,rgba(139,92,246,.16),rgba(255,255,255,.8),rgba(245,158,11,.08));pointer-events:none}
+.ramzy-panel>*{position:relative;z-index:1}
+.ramzy-panel-header{min-height:84px;padding:16px 18px;border-bottom:1px solid rgba(124,58,237,.1);background:radial-gradient(circle at 88% 10%,rgba(221,214,254,.6),transparent 32%),linear-gradient(135deg,rgba(255,255,255,.98),rgba(248,246,255,.96));color:#211b45;box-shadow:0 14px 32px rgba(76,29,149,.07),inset 0 -1px 0 rgba(255,255,255,.92)}
+.ramzy-panel-identity{gap:12px}.ramzy-panel-identity strong{color:#201a43;font-size:20px;font-weight:950;letter-spacing:-.025em;text-shadow:0 1px 0 rgba(255,255,255,.85)}.ramzy-panel-identity span{display:flex;align-items:center;gap:6px;margin-top:4px;color:#766d8d;font-size:12px;font-weight:800}
+.ramzy-online-dot{width:8px;height:8px;background:#22c77a;box-shadow:0 0 0 4px rgba(34,197,122,.12),0 4px 10px rgba(34,197,122,.2)}
+.ramzy-panel-controls{gap:7px}.ramzy-panel-controls button{width:36px;height:36px;border:1px solid rgba(99,102,241,.12);border-radius:12px;background:linear-gradient(145deg,#fff,#f2effb);color:#51486e;box-shadow:0 8px 18px rgba(68,55,120,.1),inset 0 1px 0 #fff;transition:transform .16s ease,box-shadow .16s ease,border-color .16s ease,color .16s ease}.ramzy-panel-controls button:hover{transform:translateY(-2px);border-color:rgba(124,58,237,.22);background:linear-gradient(145deg,#fff,#eee9ff);color:#6d28d9;box-shadow:0 12px 23px rgba(76,29,149,.14),inset 0 1px 0 #fff}
+.ramzy-history-select{margin:12px 16px 0;padding:10px 12px;border:1px solid rgba(124,58,237,.12);border-radius:14px;background:rgba(255,255,255,.94);color:#30284a;box-shadow:0 8px 18px rgba(68,55,120,.06)}
+.ramzy-messages{padding:22px;background:radial-gradient(circle at 96% 2%,rgba(237,233,254,.72),transparent 30%),radial-gradient(circle at 4% 96%,rgba(255,247,237,.62),transparent 26%),linear-gradient(180deg,#fbfaff 0%,#fff 46%,#fdfcff 100%);scrollbar-color:rgba(139,92,246,.26) transparent}
+.ramzy-messages::-webkit-scrollbar{width:8px}.ramzy-messages::-webkit-scrollbar-track{background:transparent}.ramzy-messages::-webkit-scrollbar-thumb{border:2px solid transparent;border-radius:999px;background:rgba(139,92,246,.24);background-clip:padding-box}
+.ramzy-message{margin-bottom:16px}.ramzy-message-content{max-width:88%;padding:14px 17px;border-radius:21px;font-size:14px;line-height:1.9;box-shadow:none;transition:transform .16s ease,box-shadow .16s ease}
+.ramzy-message.user .ramzy-message-content{border:1px solid rgba(109,40,217,.1);border-radius:21px 21px 6px 21px;background:linear-gradient(145deg,#8b5cf6,#7c3aed 58%,#6d28d9);color:#fff;box-shadow:0 14px 28px rgba(109,40,217,.22),inset 0 1px 0 rgba(255,255,255,.24),inset 0 -1px 0 rgba(76,29,149,.16)}
+.ramzy-message.assistant .ramzy-message-content{border:1px solid rgba(124,58,237,.1);border-radius:21px 21px 21px 6px;background:linear-gradient(145deg,rgba(255,255,255,.99),rgba(249,247,255,.94));color:#2a243b;box-shadow:0 16px 34px rgba(68,55,120,.09),0 4px 10px rgba(15,23,42,.035),inset 0 1px 0 #fff;backdrop-filter:blur(10px)}
+.ramzy-message.user .ramzy-message-content:hover,.ramzy-message.assistant .ramzy-message-content:hover{transform:translateY(-1px)}
+.ramzy-message-actions{gap:4px;margin-top:6px;color:#8b82a3}.ramzy-message-actions button{width:27px;height:27px;border:1px solid transparent;border-radius:9px;background:rgba(255,255,255,.72)}.ramzy-message-actions button:hover{border-color:rgba(124,58,237,.12);background:#fff;color:#6d28d9;box-shadow:0 6px 14px rgba(68,55,120,.08)}
+.ramzy-welcome{padding:34px 10px;color:#28213d}.ramzy-welcome>svg{width:34px;height:34px;padding:7px;border-radius:14px;background:linear-gradient(145deg,#fff,#eee9ff);color:#7c3aed;box-shadow:0 12px 24px rgba(109,40,217,.14),inset 0 1px 0 #fff}.ramzy-welcome strong{margin-top:13px;font-size:18px}.ramzy-welcome p{max-width:430px;color:#766d8d;font-size:13px}
+.ramzy-suggestions{grid-template-columns:repeat(2,minmax(0,1fr));max-width:560px;gap:10px;margin-top:18px}.ramzy-suggestions button{min-height:46px;padding:11px 14px;border:1px solid rgba(124,58,237,.11);border-radius:15px;background:linear-gradient(145deg,#fff,#f6f3ff);color:#5f34ae;box-shadow:0 10px 20px rgba(68,55,120,.07),inset 0 1px 0 #fff}.ramzy-suggestions button:hover{transform:translateY(-2px);border-color:rgba(124,58,237,.22);background:linear-gradient(145deg,#fff,#eee8ff);box-shadow:0 14px 26px rgba(109,40,217,.11),inset 0 1px 0 #fff}
+.ramzy-typing{border:1px solid rgba(124,58,237,.09);background:linear-gradient(145deg,#f7f3ff,#fff);color:#6d28d9;box-shadow:0 8px 18px rgba(68,55,120,.06)}.ramzy-typing button{background:#fff;color:#6d28d9;box-shadow:0 5px 12px rgba(68,55,120,.07)}
+.ramzy-error{border:1px solid rgba(220,38,38,.1);background:#fff7f7;box-shadow:0 8px 18px rgba(127,29,29,.05)}
+.ramzy-composer{gap:10px;padding:16px;border-top:1px solid rgba(124,58,237,.1);background:linear-gradient(180deg,rgba(255,255,255,.96),rgba(249,247,255,.98));box-shadow:0 -15px 34px rgba(68,55,120,.055)}
+.ramzy-composer textarea{min-height:58px;padding:15px 16px;border:1px solid rgba(124,58,237,.14);border-radius:19px;background:linear-gradient(145deg,#fff,#fbfaff);color:#28213d;font-size:14px;box-shadow:inset 0 2px 6px rgba(68,55,120,.035),0 8px 18px rgba(68,55,120,.045)}.ramzy-composer textarea::placeholder{color:#aaa2bb}.ramzy-composer textarea:focus{border-color:rgba(124,58,237,.42);background:#fff;box-shadow:0 0 0 4px rgba(139,92,246,.1),0 12px 24px rgba(109,40,217,.08),inset 0 1px 0 #fff}
+.ramzy-composer-actions{gap:8px}.ramzy-composer-actions button{width:50px;height:50px;border:1px solid rgba(124,58,237,.1);border-radius:17px}
+.ramzy-mic-button{background:linear-gradient(145deg,#fff,#eeeaf7);color:#51486e!important;box-shadow:0 10px 20px rgba(68,55,120,.1),inset 0 1px 0 #fff}.ramzy-mic-button:hover:not(:disabled){color:#6d28d9!important;box-shadow:0 13px 24px rgba(68,55,120,.13),inset 0 1px 0 #fff}.ramzy-mic-button.is-listening{border-color:rgba(239,68,68,.18);background:linear-gradient(145deg,#fff,#fff1f2);color:#dc2626!important;box-shadow:0 0 0 5px rgba(239,68,68,.08),0 10px 22px rgba(190,24,93,.1)}
+.ramzy-send-button{border-color:rgba(109,40,217,.2)!important;background:linear-gradient(145deg,#9b72ff,#7c3aed 62%,#6d28d9)!important;color:#fff!important;box-shadow:0 14px 26px rgba(109,40,217,.24),inset 0 1px 0 rgba(255,255,255,.28)!important}.ramzy-send-button:hover:not(:disabled){box-shadow:0 17px 30px rgba(109,40,217,.29),inset 0 1px 0 rgba(255,255,255,.32)!important}
+.ramzy-voice-status{color:#7d7394}.ramzy-voice-status.is-listening{color:#7c3aed}
+.ramzy-approval-card{border-color:rgba(217,119,6,.15);border-radius:18px;background:linear-gradient(145deg,#fffdf7,#fff8e8);color:#6f4215;box-shadow:0 12px 26px rgba(120,53,15,.07),inset 0 1px 0 #fff}
+.ramzy-minimized{border:1px solid rgba(124,58,237,.13);background:linear-gradient(145deg,#fff,#f0ecfb);color:#4c3678;box-shadow:0 14px 30px rgba(68,55,120,.13),inset 0 1px 0 #fff}
+.ramzy-launcher-label,.ramzy-greeting{border:1px solid rgba(124,58,237,.12);background:linear-gradient(145deg,rgba(255,255,255,.98),rgba(245,242,253,.98));color:#2a2340;box-shadow:0 14px 28px rgba(68,55,120,.13),inset 0 1px 0 #fff}.ramzy-launcher-label small{color:#7d7590}
+.ramzy-avatar-ring{background:linear-gradient(145deg,rgba(255,255,255,.98),rgba(237,233,254,.96));box-shadow:0 16px 34px rgba(76,29,149,.15),0 0 0 7px rgba(221,214,254,.28),inset 0 1px 0 #fff}.ramzy-launcher:hover .ramzy-avatar-ring{box-shadow:0 20px 40px rgba(76,29,149,.18),0 0 0 8px rgba(221,214,254,.34),inset 0 1px 0 #fff}
+.ramzy-launcher-close{border-color:#fff;background:linear-gradient(145deg,#fff,#ece9f3);color:#6f6682;box-shadow:0 8px 18px rgba(68,55,120,.15)}.ramzy-launcher-close:hover{background:#f4f0ff;color:#6d28d9}
+/* Force only Ramzy to stay light even when the surrounding TOS app is dark. */
+.dark .ramzy-panel{border-color:rgba(124,58,237,.12);background:radial-gradient(circle at 82% -8%,rgba(196,181,253,.3),transparent 34%),linear-gradient(145deg,#fff,#faf8ff 56%,#fffdf9);color:#1f1b2d}
+.dark .ramzy-panel-header{border-bottom-color:rgba(124,58,237,.1);background:radial-gradient(circle at 88% 10%,rgba(221,214,254,.6),transparent 32%),linear-gradient(135deg,#fff,#f8f6ff);color:#211b45}.dark .ramzy-panel-identity strong{color:#201a43}.dark .ramzy-panel-identity span{color:#766d8d}
+.dark .ramzy-panel-controls button{border-color:rgba(99,102,241,.12);background:linear-gradient(145deg,#fff,#f2effb);color:#51486e}.dark .ramzy-history-select{border-color:rgba(124,58,237,.12);background:#fff;color:#30284a}
+.dark .ramzy-messages{background:radial-gradient(circle at 96% 2%,rgba(237,233,254,.72),transparent 30%),linear-gradient(180deg,#fbfaff,#fff 46%,#fdfcff)}
+.dark .ramzy-message.assistant .ramzy-message-content{border-color:rgba(124,58,237,.1);background:linear-gradient(145deg,#fff,#f9f7ff);color:#2a243b}.dark .ramzy-message-actions{color:#8b82a3}.dark .ramzy-message-actions button{background:rgba(255,255,255,.72)}
+.dark .ramzy-welcome{color:#28213d}.dark .ramzy-welcome p{color:#766d8d}.dark .ramzy-suggestions button{border-color:rgba(124,58,237,.11);background:linear-gradient(145deg,#fff,#f6f3ff);color:#5f34ae}
+.dark .ramzy-composer{border-top-color:rgba(124,58,237,.1);background:linear-gradient(180deg,#fff,#f9f7ff)}.dark .ramzy-composer textarea{border-color:rgba(124,58,237,.14);background:linear-gradient(145deg,#fff,#fbfaff);color:#28213d}.dark .ramzy-voice-status{color:#7d7394}.dark .ramzy-voice-status.is-listening{color:#7c3aed}
+.dark .ramzy-markdown{color:#2a243b}.dark .ramzy-markdown a{color:#6d28d9}.dark .ramzy-markdown-pre{border-color:rgba(124,58,237,.12);background:#f6f3ff;color:#32294a}.dark .ramzy-markdown-table-wrap{border-color:rgba(124,58,237,.12)}.dark .ramzy-markdown-table-wrap th{background:#f3efff;color:#4c3678}
+.dark .ramzy-result-card{border-color:rgba(124,58,237,.12);background:linear-gradient(145deg,#fff,#faf8ff);color:#2a243b}.dark .ramzy-result-field>span{color:#7a728d}.dark .ramzy-result-field>b.ramzy-status-badge{background:#ede9fe;color:#5b21b6}
+.dark .ramzy-approval-card{border-color:rgba(217,119,6,.15);background:linear-gradient(145deg,#fffdf7,#fff8e8);color:#6f4215}.dark .ramzy-approval-card small{color:#92400e}
+@media(max-width:640px){.ramzy-panel{border-radius:24px;box-shadow:0 24px 58px rgba(68,55,120,.16),0 10px 24px rgba(15,23,42,.07)}.ramzy-panel::before{border-radius:24px 24px 0 0}.ramzy-panel-header{min-height:70px;padding:12px 13px}.ramzy-panel-controls{gap:4px}.ramzy-panel-controls button{width:31px;height:31px;border-radius:10px}.ramzy-messages{padding:14px}.ramzy-message-content{max-width:94%;padding:12px 14px;font-size:13px}.ramzy-suggestions{grid-template-columns:1fr;gap:8px}.ramzy-composer{padding:11px;gap:7px}.ramzy-composer textarea{min-height:50px;padding:11px 12px;font-size:13px}.ramzy-composer-actions button{width:44px;height:44px;border-radius:14px}}
