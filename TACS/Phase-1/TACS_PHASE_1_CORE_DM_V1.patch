+++ b/server/tacsRouter.ts
@@
+import { TRPCError } from "@trpc/server";
+import { and, asc, desc, eq, gt, ne } from "drizzle-orm";
+import { z } from "zod";
+import { protectedProcedure, router } from "./_core/trpc";
+import { getDb } from "./db";
+import {
+  departments,
+  employees,
+  tacsConversationMembers,
+  tacsConversations,
+  tacsMessages,
+  users,
+} from "../drizzle/schema";
+
+async function assertMember(userId: number, conversationId: number) {
+  const db = await getDb();
+  const rows = await db
+    .select({ id: tacsConversationMembers.id })
+    .from(tacsConversationMembers)
+    .where(
+      and(
+        eq(tacsConversationMembers.conversationId, conversationId),
+        eq(tacsConversationMembers.userId, userId),
+      ),
+    )
+    .limit(1);
+
+  if (!rows[0]) {
+    throw new TRPCError({ code: "FORBIDDEN", message: "You are not a member of this conversation." });
+  }
+}
+
+async function getConversationMembers(conversationId: number) {
+  const db = await getDb();
+  return db
+    .select({
+      id: users.id,
+      name: users.name,
+      email: users.email,
+      role: users.role,
+      position: employees.position,
+      departmentName: departments.name,
+    })
+    .from(tacsConversationMembers)
+    .innerJoin(users, eq(tacsConversationMembers.userId, users.id))
+    .leftJoin(employees, eq(employees.userId, users.id))
+    .leftJoin(departments, eq(departments.id, employees.departmentId))
+    .where(eq(tacsConversationMembers.conversationId, conversationId));
+}
+
+export const tacsRouter = router({
+  directory: protectedProcedure.query(async ({ ctx }) => {
+    const db = await getDb();
+    const rows = await db
+      .select({
+        id: users.id,
+        name: users.name,
+        email: users.email,
+        role: users.role,
+        position: employees.position,
+        departmentName: departments.name,
+        isActive: employees.isActive,
+      })
+      .from(users)
+      .leftJoin(employees, eq(employees.userId, users.id))
+      .leftJoin(departments, eq(departments.id, employees.departmentId));
+
+    return rows.filter((row) => row.id !== ctx.user.id && row.isActive !== false);
+  }),
+
+  list: protectedProcedure.query(async ({ ctx }) => {
+    const db = await getDb();
+    const memberships = await db
+      .select({
+        conversationId: tacsConversationMembers.conversationId,
+        lastReadAt: tacsConversationMembers.lastReadAt,
+        type: tacsConversations.type,
+        title: tacsConversations.title,
+        updatedAt: tacsConversations.updatedAt,
+      })
+      .from(tacsConversationMembers)
+      .innerJoin(tacsConversations, eq(tacsConversationMembers.conversationId, tacsConversations.id))
+      .where(eq(tacsConversationMembers.userId, ctx.user.id))
+      .orderBy(desc(tacsConversations.updatedAt));
+
+    return Promise.all(
+      memberships.map(async (membership) => {
+        const [members, latestRows, unreadRows] = await Promise.all([
+          getConversationMembers(membership.conversationId),
+          db
+            .select({
+              id: tacsMessages.id,
+              senderId: tacsMessages.senderId,
+              content: tacsMessages.content,
+              createdAt: tacsMessages.createdAt,
+            })
+            .from(tacsMessages)
+            .where(
+              and(
+                eq(tacsMessages.conversationId, membership.conversationId),
+                eq(tacsMessages.messageType, "text"),
+              ),
+            )
+            .orderBy(desc(tacsMessages.createdAt))
+            .limit(1),
+          membership.lastReadAt
+            ? db
+                .select({ id: tacsMessages.id })
+                .from(tacsMessages)
+                .where(
+                  and(
+                    eq(tacsMessages.conversationId, membership.conversationId),
+                    ne(tacsMessages.senderId, ctx.user.id),
+                    gt(tacsMessages.createdAt, membership.lastReadAt),
+                  ),
+                )
+            : db
+                .select({ id: tacsMessages.id })
+                .from(tacsMessages)
+                .where(
+                  and(
+                    eq(tacsMessages.conversationId, membership.conversationId),
+                    ne(tacsMessages.senderId, ctx.user.id),
+                  ),
+                ),
+        ]);
+
+        return {
+          ...membership,
+          members,
+          latestMessage: latestRows[0] ?? null,
+          unreadCount: unreadRows.length,
+        };
+      }),
+    );
+  }),
+
+  unreadTotal: protectedProcedure.query(async ({ ctx }) => {
+    const db = await getDb();
+    const memberships = await db
+      .select({
+        conversationId: tacsConversationMembers.conversationId,
+        lastReadAt: tacsConversationMembers.lastReadAt,
+      })
+      .from(tacsConversationMembers)
+      .where(eq(tacsConversationMembers.userId, ctx.user.id));
+
+    let count = 0;
+    for (const membership of memberships) {
+      const conditions = [
+        eq(tacsMessages.conversationId, membership.conversationId),
+        ne(tacsMessages.senderId, ctx.user.id),
+      ];
+      if (membership.lastReadAt) conditions.push(gt(tacsMessages.createdAt, membership.lastReadAt));
+      const rows = await db.select({ id: tacsMessages.id }).from(tacsMessages).where(and(...conditions));
+      count += rows.length;
+    }
+    return { count };
+  }),
+
+  openDirect: protectedProcedure
+    .input(z.object({ targetUserId: z.number().int().positive() }))
+    .mutation(async ({ ctx, input }) => {
+      if (input.targetUserId === ctx.user.id) {
+        throw new TRPCError({ code: "BAD_REQUEST", message: "You cannot start a chat with yourself." });
+      }
+
+      const db = await getDb();
+      const target = await db
+        .select({ id: users.id })
+        .from(users)
+        .where(eq(users.id, input.targetUserId))
+        .limit(1);
+      if (!target[0]) throw new TRPCError({ code: "NOT_FOUND", message: "User not found." });
+
+      const directKey = [ctx.user.id, input.targetUserId].sort((a, b) => a - b).join(":");
+      let conversation = (
+        await db
+          .select({ id: tacsConversations.id })
+          .from(tacsConversations)
+          .where(eq(tacsConversations.directKey, directKey))
+          .limit(1)
+      )[0];
+
+      if (!conversation) {
+        try {
+          const result = await db.insert(tacsConversations).values({
+            type: "direct",
+            directKey,
+            createdBy: ctx.user.id,
+          });
+          conversation = { id: result[0].insertId };
+        } catch {
+          conversation = (
+            await db
+              .select({ id: tacsConversations.id })
+              .from(tacsConversations)
+              .where(eq(tacsConversations.directKey, directKey))
+              .limit(1)
+          )[0];
+        }
+      }
+
+      if (!conversation) {
+        throw new TRPCError({ code: "INTERNAL_SERVER_ERROR", message: "Could not create conversation." });
+      }
+
+      for (const userId of [ctx.user.id, input.targetUserId]) {
+        const member = await db
+          .select({ id: tacsConversationMembers.id })
+          .from(tacsConversationMembers)
+          .where(
+            and(
+              eq(tacsConversationMembers.conversationId, conversation.id),
+              eq(tacsConversationMembers.userId, userId),
+            ),
+          )
+          .limit(1);
+        if (!member[0]) {
+          await db.insert(tacsConversationMembers).values({
+            conversationId: conversation.id,
+            userId,
+            lastReadAt: userId === ctx.user.id ? new Date() : null,
+          });
+        }
+      }
+
+      return { conversationId: conversation.id };
+    }),
+
+  messages: protectedProcedure
+    .input(z.object({ conversationId: z.number().int().positive() }))
+    .query(async ({ ctx, input }) => {
+      await assertMember(ctx.user.id, input.conversationId);
+      const db = await getDb();
+      return db
+        .select({
+          id: tacsMessages.id,
+          conversationId: tacsMessages.conversationId,
+          senderId: tacsMessages.senderId,
+          senderName: users.name,
+          content: tacsMessages.content,
+          createdAt: tacsMessages.createdAt,
+          editedAt: tacsMessages.editedAt,
+        })
+        .from(tacsMessages)
+        .innerJoin(users, eq(users.id, tacsMessages.senderId))
+        .where(
+          and(
+            eq(tacsMessages.conversationId, input.conversationId),
+            eq(tacsMessages.messageType, "text"),
+          ),
+        )
+        .orderBy(asc(tacsMessages.createdAt))
+        .limit(250);
+    }),
+
+  send: protectedProcedure
+    .input(
+      z.object({
+        conversationId: z.number().int().positive(),
+        content: z.string().trim().min(1).max(4000),
+      }),
+    )
+    .mutation(async ({ ctx, input }) => {
+      await assertMember(ctx.user.id, input.conversationId);
+      const db = await getDb();
+      const result = await db.insert(tacsMessages).values({
+        conversationId: input.conversationId,
+        senderId: ctx.user.id,
+        content: input.content,
+        messageType: "text",
+      });
+      await db
+        .update(tacsConversations)
+        .set({ updatedAt: new Date() })
+        .where(eq(tacsConversations.id, input.conversationId));
+      return { id: result[0].insertId };
+    }),
+
+  markRead: protectedProcedure
+    .input(z.object({ conversationId: z.number().int().positive() }))
+    .mutation(async ({ ctx, input }) => {
+      await assertMember(ctx.user.id, input.conversationId);
+      const db = await getDb();
+      await db
+        .update(tacsConversationMembers)
+        .set({ lastReadAt: new Date() })
+        .where(
+          and(
+            eq(tacsConversationMembers.conversationId, input.conversationId),
+            eq(tacsConversationMembers.userId, ctx.user.id),
+          ),
+        );
+      return { success: true } as const;
+    }),
+});
