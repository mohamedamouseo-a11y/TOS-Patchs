+function normalizeTaskAssigneeSearchText(value = "") {
+  return String(value || "")
+    .normalize("NFKD")
+    .replace(/[\u064B-\u065F\u0670\u0640]/g, "")
+    .replace(/[إأآٱ]/g, "ا")
+    .replace(/ى/g, "ي")
+    .replace(/ة/g, "ه")
+    .replace(/\s+/g, " ")
+    .trim()
+    .toLowerCase();
+}
+
+function taskAssigneeNearTokenMatch(value, query) {
+  if (value === query) return true;
+  if (Math.abs(value.length - query.length) > 1) return false;
+
+  if (value.length === query.length) {
+    const mismatches = [];
+    for (let index = 0; index < value.length; index += 1) {
+      if (value[index] !== query[index]) mismatches.push(index);
+      if (mismatches.length > 2) return false;
+    }
+    if (mismatches.length <= 1) return true;
+    const [first, second] = mismatches;
+    return second === first + 1 && value[first] === query[second] && value[second] === query[first];
+  }
+
+  const longer = value.length > query.length ? value : query;
+  const shorter = value.length > query.length ? query : value;
+  let longIndex = 0;
+  let shortIndex = 0;
+  let edits = 0;
+  while (longIndex < longer.length && shortIndex < shorter.length) {
+    if (longer[longIndex] === shorter[shortIndex]) {
+      longIndex += 1;
+      shortIndex += 1;
+      continue;
+    }
+    edits += 1;
+    longIndex += 1;
+    if (edits > 1) return false;
+  }
+  return true;
+}
+
+function taskAssigneeSearchTokenMatches(haystack, token) {
+  if (haystack.includes(token)) return true;
+  if (token.length < 4) return false;
+  return haystack.split(/\s+/).some((word) => taskAssigneeNearTokenMatch(word, token));
+}
