+
   const userQuery = selectedUserId ? clarificationSelection.candidate.name : (intentResolution.slots?.assigneeQuery || extractUserQuery(requestText));
   const assigneeIntent = ["TASK_BY_ASSIGNEE", "TASK_OVERDUE", "TASK_BLOCKED", "TASK_SEARCH"].includes(detectedIntent)
