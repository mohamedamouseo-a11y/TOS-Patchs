   const contextualProjectId = contextResolution.useActiveProject ? contextResolution.activeProjectId : null;
   const projectResolution = explicitProject || (contextualProjectId ? await resolveProject(user, settings, previous.activeProjectName || "", workspaceId, contextualProjectId) : null);
   const project = projectResolution?.entity || null;
+
+  // Safety path for a validated project choice after clarification.
