+import { prisma } from "../../prisma.js";
+import { normalizeEntityText } from "./entityResolution.service.js";
+
+const SUPPORTED_ENTITY_TYPES = new Set(["PROJECT", "USER"]);
+
+function bounded(value, max = 240) {
+  return String(value || "").trim().slice(0, max);
+}
+
+function normalizeEntityType(value) {
+  const type = String(value || "").trim().toUpperCase();
+  return SUPPORTED_ENTITY_TYPES.has(type) ? type : null;
+}
+
+function entityTypeFromLabel(value) {
+  const label = normalizeEntityText(value);
+  if (["مشروع", "المشروع", "project"].includes(label)) return "PROJECT";
+  if (["موظف", "الموظف", "مستخدم", "المستخدم", "employee", "user"].includes(label)) return "USER";
+  return null;
+}
+
+export async function findMatchingEntityAliases({ user, workspaceId, entityType, query, limit = 20 }) {
+  const normalizedAlias = normalizeEntityText(query);
+  const type = normalizeEntityType(entityType);
+  if (!user?.id || !workspaceId || !type || !normalizedAlias) return [];
+  return prisma.ramzyEntityAlias.findMany({
+    where: {
+      workspaceId,
+      entityType: type,
+      normalizedAlias,
+      isActive: true,
+      OR: [{ userId: user.id }, { userId: null }],
+    },
+    orderBy: [{ confidence: "desc" }, { updatedAt: "desc" }],
+    take: Math.max(1, Math.min(50, Number(limit) || 20)),
+  });
+}
+
+export async function learnEntityAlias({
+  user,
+  workspaceId,
+  entityType,
+  entityId,
+  canonicalName,
+  alias,
+  confidence = 0.99,
+  source = "EXPLICIT_USER",
+}) {
+  const type = normalizeEntityType(entityType);
+  const normalizedAlias = normalizeEntityText(alias);
+  const normalizedCanonical = normalizeEntityText(canonicalName);
+  if (!user?.id || !workspaceId || !type || !entityId || !normalizedAlias) return null;
+  if (normalizedAlias === normalizedCanonical) return null;
+  const safeConfidence = Math.max(0.9, Math.min(1, Number(confidence) || 0.99));
+  return prisma.ramzyEntityAlias.upsert({
+    where: {
+      workspaceId_userId_entityType_normalizedAlias: {
+        workspaceId,
+        userId: user.id,
+        entityType: type,
+        normalizedAlias,
+      },
+    },
+    create: {
+      workspaceId,
+      userId: user.id,
+      entityType: type,
+      entityId,
+      canonicalName: bounded(canonicalName),
+      alias: bounded(alias),
+      normalizedAlias,
+      confidence: safeConfidence,
+      source,
+      lastUsedAt: new Date(),
+    },
+    update: {
+      entityId,
+      canonicalName: bounded(canonicalName),
+      alias: bounded(alias),
+      confidence: safeConfidence,
+      source,
+      lastUsedAt: new Date(),
+      isActive: true,
+    },
+  });
+}
+
+export function parseExplicitAliasInstruction(message) {
+  const raw = String(message || "").trim();
+  if (!raw) return null;
+
+  const rememberPattern = raw.match(/(?:اعتبر|افتكر|احفظ|remember)\s+(?:ان|إن|انّ|إنّ)?\s*(مشروع|المشروع|project|موظف|الموظف|مستخدم|المستخدم|employee|user)\s+(.+?)\s+(?:هو|يعني|=|means|is)\s+(.+)$/iu);
+  if (rememberPattern) {
+    const entityType = entityTypeFromLabel(rememberPattern[1]);
+    const alias = bounded(rememberPattern[2]);
+    const canonicalQuery = bounded(rememberPattern[3]);
+    return entityType && alias && canonicalQuery ? { entityType, alias, canonicalQuery, mode: "ALIAS_TO_CANONICAL" } : null;
+  }
+
+  const namePattern = raw.match(/(?:سمي|سمّي|سميه|سمّيه|call)\s+(مشروع|المشروع|project|موظف|الموظف|مستخدم|المستخدم|employee|user)\s+(.+?)\s+(?:باسم|as)\s+(.+)$/iu);
+  if (namePattern) {
+    const entityType = entityTypeFromLabel(namePattern[1]);
+    const canonicalQuery = bounded(namePattern[2]);
+    const alias = bounded(namePattern[3]);
+    return entityType && alias && canonicalQuery ? { entityType, alias, canonicalQuery, mode: "CANONICAL_TO_ALIAS" } : null;
+  }
+
+  return null;
+}
+
+export function getAliasLearningConfig() {
+  return {
+    version: "RAMZY_ALIAS_LEARNING_V1",
+    supportedEntityTypes: [...SUPPORTED_ENTITY_TYPES],
+    learningMode: "EXPLICIT_USER_ONLY",
+    workspaceScoped: true,
+    userScoped: true,
+  };
+}
