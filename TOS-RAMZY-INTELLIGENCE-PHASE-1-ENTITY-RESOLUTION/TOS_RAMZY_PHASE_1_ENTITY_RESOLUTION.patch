+++ b/backend/src/agency-operator/services/entityResolution.service.js
@@ -0,0 +1,143 @@
+const DEFAULT_LIMIT = 8;
+
+export function normalizeEntityText(value) {
+  return String(value || "")
+    .normalize("NFKC")
+    .toLowerCase()
+    .replace(/[ًٌٍَُِّْـ]/g, "")
+    .replace(/[أإآٱ]/g, "ا")
+    .replace(/ى/g, "ي")
+    .replace(/ة/g, "ه")
+    .replace(/[ؤئ]/g, "ء")
+    .replace(/[^\p{L}\p{N}\s@._-]/gu, " ")
+    .replace(/\s+/g, " ")
+    .trim();
+}
+
+export function tokenizeEntityText(value) {
+  return normalizeEntityText(value).split(/\s+/).filter((token) => token.length > 1);
+}
+
+function candidateValues(candidate, fields) {
+  return fields
+    .flatMap((field) => {
+      const value = candidate?.[field];
+      return Array.isArray(value) ? value : [value];
+    })
+    .map((value) => ({ raw: value, normalized: normalizeEntityText(value) }))
+    .filter((entry) => entry.normalized);
+}
+
+function scoreValue(query, value) {
+  if (!query || !value) return { score: 0, matchType: "NONE" };
+  if (query === value) return { score: 1, matchType: "EXACT" };
+  if (value.startsWith(query)) return { score: 0.9, matchType: "PREFIX" };
+  if (value.includes(query)) return { score: 0.82, matchType: "CONTAINS" };
+
+  const queryTokens = tokenizeEntityText(query);
+  if (!queryTokens.length) return { score: 0, matchType: "NONE" };
+  const matches = queryTokens.filter((token) => value.includes(token)).length;
+  if (!matches) return { score: 0, matchType: "NONE" };
+  return {
+    score: 0.65 + (matches / queryTokens.length) * 0.2,
+    matchType: "TOKEN_OVERLAP",
+  };
+}
+
+export function scoreEntityCandidate(query, candidate, {
+  fields = ["name"],
+  aliasField = null,
+} = {}) {
+  const normalizedQuery = normalizeEntityText(query);
+  let best = { score: 0, matchType: "NONE", matchedField: null, matchedValue: null };
+
+  for (const field of fields) {
+    for (const entry of candidateValues(candidate, [field])) {
+      const scored = scoreValue(normalizedQuery, entry.normalized);
+      if (scored.score > best.score) {
+        best = { ...scored, matchedField: field, matchedValue: entry.raw };
+      }
+    }
+  }
+
+  if (aliasField && candidate?.[aliasField] && best.score < 0.98) {
+    best = { score: 0.98, matchType: "ALIAS", matchedField: aliasField, matchedValue: true };
+  }
+
+  return best;
+}
+
+export function resolveEntityCandidates({
+  query,
+  candidates = [],
+  fields = ["name"],
+  exactFields = fields,
+  idField = "id",
+  explicitId = null,
+  aliasField = null,
+  limit = DEFAULT_LIMIT,
+  ambiguityDelta = 0.08,
+  ambiguityAutoResolveThreshold = 0.9,
+} = {}) {
+  const normalizedQuery = normalizeEntityText(query);
+  const boundedLimit = Math.max(1, Math.min(50, Number(limit) || DEFAULT_LIMIT));
+
+  if (explicitId) {
+    const entity = candidates.find((candidate) => String(candidate?.[idField] || "") === String(explicitId));
+    return entity
+      ? { entity, confidence: 1, matchType: "EXPLICIT_ID", candidates: [entity], clarificationRequired: false, ambiguityReason: null }
+      : { entity: null, confidence: 0, matchType: "NONE", candidates: [], clarificationRequired: false, ambiguityReason: "ID_NOT_FOUND" };
+  }
+
+  if (!normalizedQuery) {
+    return { entity: null, confidence: 0, matchType: "NONE", candidates: [], clarificationRequired: false, ambiguityReason: "EMPTY_QUERY" };
+  }
+
+  const ranked = candidates
+    .map((candidate) => ({
+      ...candidate,
+      ...scoreEntityCandidate(normalizedQuery, candidate, { fields, aliasField }),
+    }))
+    .filter((candidate) => candidate.score > 0)
+    .sort((a, b) => b.score - a.score)
+    .slice(0, boundedLimit);
+
+  if (!ranked.length) {
+    return { entity: null, confidence: 0, matchType: "NONE", candidates: [], clarificationRequired: false, ambiguityReason: "NO_MATCH" };
+  }
+
+  const exactMatches = ranked.filter((candidate) => exactFields.some((field) => (
+    candidateValues(candidate, [field]).some((entry) => entry.normalized === normalizedQuery)
+  )));
+  if (exactMatches.length > 1) {
+    return {
+      entity: null,
+      confidence: 1,
+      matchType: "EXACT",
+      candidates: exactMatches,
+      clarificationRequired: true,
+      ambiguityReason: "EXACT_DUPLICATE",
+    };
+  }
+
+  const top = ranked[0];
+  const close = ranked.filter((candidate) => top.score - candidate.score < ambiguityDelta);
+  if (close.length > 1 && top.score < ambiguityAutoResolveThreshold) {
+    return {
+      entity: null,
+      confidence: top.score,
+      matchType: top.matchType,
+      candidates: close,
+      clarificationRequired: true,
+      ambiguityReason: "LOW_CONFIDENCE_TIE",
+    };
+  }
+
+  return {
+    entity: top,
+    confidence: top.score,
+    matchType: top.matchType,
+    candidates: ranked,
+    clarificationRequired: false,
+    ambiguityReason: null,
+  };
+}
+
+export function getEntityResolutionConfig() {
+  return {
+    version: "RAMZY_ENTITY_RESOLUTION_V1",
+    strategies: ["EXPLICIT_ID", "EXACT", "ALIAS_COMPAT", "PREFIX", "CONTAINS", "TOKEN_OVERLAP"],
+    multilingualNormalization: ["UNICODE_NFKC", "ARABIC_DIACRITICS", "ARABIC_LETTER_NORMALIZATION", "CASE_FOLDING"],
+  };
+}
