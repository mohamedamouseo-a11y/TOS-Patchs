+function isInternalIdKey(key) {
+  return /(?:^id$|id$|ids$)/i.test(String(key || ""));
+}
+
+function collectInternalIdentifiers(value, key = "", found = new Set()) {
+  if (value === null || value === undefined) return found;
+  if (Array.isArray(value)) {
+    for (const item of value) {
+      if (isInternalIdKey(key) && typeof item === "string" && item.length >= 8) found.add(item);
+      collectInternalIdentifiers(item, key, found);
+    }
+    return found;
+  }
+  if (typeof value === "object") {
+    for (const [childKey, childValue] of Object.entries(value)) {
+      if (isInternalIdKey(childKey) && typeof childValue === "string" && childValue.length >= 8) found.add(childValue);
+      if (isInternalIdKey(childKey) && Array.isArray(childValue)) {
+        for (const item of childValue) if (typeof item === "string" && item.length >= 8) found.add(item);
+      }
+      collectInternalIdentifiers(childValue, childKey, found);
+    }
+  }
+  return found;
+}
+
+function lineLooksLikeInternalIdField(line) {
+  const text = String(line || "").trim();
+  if (!text) return false;
+  return /(?:\b(?:project|task|user|client|workspace|board|conversation)\s*id\b|\bID\b|معرف\s+(?:المشروع|المهمة|الموظف|المستخدم|العميل|مساحة العمل|اللوحة|المحادثة)|رقم\s+(?:المشروع|المهمة|الموظف|المستخدم|العميل))/iu.test(text);
+}
+
+function sanitizeUserVisibleInternalIds(text, intelligence = null) {
+  let output = String(text || "");
+  const identifiers = [...collectInternalIdentifiers(intelligence || {})]
+    .filter((value) => value && value.length >= 8)
+    .sort((a, b) => b.length - a.length);
+
+  for (const identifier of identifiers) {
+    output = output.split(`[${identifier}]`).join("");
+    output = output.split(`(${identifier})`).join("");
+    output = output.split(identifier).join("");
+  }
+
+  // TOS currently uses CUID-like database identifiers. This catches IDs surfaced only
+  // through provider tool results that are not already present in System Intelligence.
+  output = output.replace(/\bc[a-z0-9]{20,40}\b/gi, "");
+
+  output = output
+    .split("\n")
+    .filter((line) => !lineLooksLikeInternalIdField(line))
+    .join("\n")
+    .replace(/\[\s*\]/g, "")
+    .replace(/\(\s*\)/g, "")
+    .replace(/[ \t]+$/gm, "")
+    .replace(/\n{3,}/g, "\n\n")
+    .trim();
+
+  return output;
+}
