+import { useCallback, useEffect, useRef, useState } from "react";
+import { connectSocket } from "../lib/socket";
+
+export function useGlobalTcsUnread({ userId = "", activePage = "", onOpen = null, authoritativeUnreadCount = 0 } = {}) {
+  const [unreadCount, setUnreadCount] = useState(Math.max(0, Number(authoritativeUnreadCount) || 0));
+  const [alert, setAlert] = useState(null);
+  const seenNotificationIdsRef = useRef(new Set());
+  const onOpenRef = useRef(onOpen);
+
+  useEffect(() => {
+    onOpenRef.current = onOpen;
+  }, [onOpen]);
+
+  useEffect(() => {
+    if (!userId) {
+      setUnreadCount(0);
+      setAlert(null);
+      seenNotificationIdsRef.current.clear();
+      return;
+    }
+    setUnreadCount(Math.max(0, Number(authoritativeUnreadCount) || 0));
+  }, [authoritativeUnreadCount, userId]);
+
+  useEffect(() => {
+    if (activePage === "chat") setAlert(null);
+  }, [activePage]);
+
+  useEffect(() => {
+    if (!userId) return undefined;
+    const socket = connectSocket();
+    const handleNotification = (notification = {}) => {
+      const notificationId = String(notification?.id || "").trim();
+      if (!notificationId || seenNotificationIdsRef.current.has(notificationId)) return;
+      seenNotificationIdsRef.current.add(notificationId);
+      if (notification.readAt) return;
+      setUnreadCount((count) => count + 1);
+      if (activePage !== "chat") setAlert((current) => current || notification);
+    };
+    const handleMessagesRead = (payload = {}) => {
+      if (payload.userId === userId) setAlert(null);
+    };
+
+    socket.on("chat:notification", handleNotification);
+    socket.on("messages:read", handleMessagesRead);
+    return () => {
+      socket.off("chat:notification", handleNotification);
+      socket.off("messages:read", handleMessagesRead);
+    };
+  }, [activePage, userId]);
+
+  const dismissAlert = useCallback(() => setAlert(null), []);
+  const openAlert = useCallback(() => {
+    setAlert(null);
+    onOpenRef.current?.();
+  }, []);
+  const refresh = useCallback(() => {
+    setUnreadCount(userId ? Math.max(0, Number(authoritativeUnreadCount) || 0) : 0);
+  }, [authoritativeUnreadCount, userId]);
+
+  return { unreadCount, alert, dismissAlert, openAlert, refresh };
+}
+

