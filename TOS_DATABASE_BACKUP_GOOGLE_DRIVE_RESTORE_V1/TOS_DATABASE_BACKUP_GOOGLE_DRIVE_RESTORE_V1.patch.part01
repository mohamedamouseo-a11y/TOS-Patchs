diff --git a/backend/.env.example b/backend/.env.example
--- a/backend/.env.example
+++ b/backend/.env.example
@@ -18,4 +18,10 @@ DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
 JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
 DRIVE_TOKEN_ENCRYPTION_KEY=change_this_to_32_bytes_hex_or_base64
+
+# Dedicated encrypted PostgreSQL backup (independent from normal Drive storage)
+# Generate with: openssl rand -hex 32
+TOS_DB_BACKUP_ENCRYPTION_KEY=change_this_to_64_hex_chars
+TOS_DB_BACKUP_CONFIG_DIR=/var/lib/tos/database-backups
+TOS_DB_BACKUP_TMP_DIR=/var/tmp/tos-db-backups
 COOKIE_SAME_SITE=lax
 COOKIE_SECURE=true
diff --git a/backend/src/server.js b/backend/src/server.js
--- a/backend/src/server.js
+++ b/backend/src/server.js
@@ -4,6 +4,7 @@ import { Server } from "socket.io";
 import { createApp } from "./app.js";
 import { registerSockets } from "./sockets.js";
 import { startSystemBackupScheduler } from "./services/systemBackup.service.js";
+import { isDatabaseRestoreInProgress, startDatabaseBackupScheduler } from "./services/databaseBackup.service.js";
 import { startTcrmProjectPullScheduler } from "./services/tcrmProjectPull.service.js";
 import { bootstrapTgwsSettings } from "./services/tgws.service.js";
 import { startRamzyScheduler } from "./agency-operator/services/ramzyScheduler.service.js";
@@ -49,6 +50,11 @@ const app = createApp(io);
 server.removeAllListeners("request");
 server.on("request", app);
+io.use((socket, next) => {
+  if (isDatabaseRestoreInProgress()) return next(new Error("Database maintenance in progress"));
+  return next();
+});
 registerSockets(io);
 startSystemBackupScheduler();
+startDatabaseBackupScheduler();
 startTcrmProjectPullScheduler();
 startRamzyScheduler();
diff --git a/backend/src/app.js b/backend/src/app.js
--- a/backend/src/app.js
+++ b/backend/src/app.js
@@ -25,5 +25,7 @@ import auditLogRoutes from "./routes/auditLog.routes.js";
 import crmProjectsIntegrationRoutes from "./routes/crmProjectsIntegration.routes.js";
 import systemBackupRoutes from "./routes/systemBackup.routes.js";
+import databaseBackupRoutes from "./routes/databaseBackup.routes.js";
+import { isDatabaseRestoreInProgress } from "./services/databaseBackup.service.js";
 import employeeWorkRoutes from "./routes/employeeWork.routes.js";
 import emailSettingsRoutes from "./routes/emailSettings.routes.js";
 import centralChatNativeRoutes from "./routes/centralChatNative.routes.js";
@@ -150,6 +152,13 @@ export function createApp(io = null) {
     next();
   });
 
+  app.use(API, (req, res, next) => {
+    if (isDatabaseRestoreInProgress() && !req.originalUrl.startsWith(`${API}/database-backups`)) {
+      return res.status(503).json({ message: "Database restore in progress. Please retry shortly." });
+    }
+    return next();
+  });
+
   app.get(`${BASE}/health`, (_req, res) => res.json({ ok: true, service: "tamiyouz-backend", time: new Date() }));
 
   app.use(`${API}/auth`, authRoutes);
@@ -168,5 +178,6 @@ export function createApp(io = null) {
   app.use(`${API}/audit-log`, auditLogRoutes);
   app.use(`${API}/integrations/crm`, crmProjectsIntegrationRoutes);
   app.use(`${API}/system-backups`, systemBackupRoutes);
+  app.use(`${API}/database-backups`, databaseBackupRoutes);
   app.use(`${API}/employee-work`, employeeWorkRoutes);
   app.use(`${API}/email-settings`, emailSettingsRoutes);
diff --git a/frontend/src/lib/api.js b/frontend/src/lib/api.js
