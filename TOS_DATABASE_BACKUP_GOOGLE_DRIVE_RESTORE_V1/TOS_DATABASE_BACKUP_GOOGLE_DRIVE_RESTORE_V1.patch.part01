     runNow: () => request("/api/system-backups/run-now", { method: "POST" }),
   },
+  databaseBackups: {
+    status: () => request("/api/database-backups/status"),
+    updateSettings: (payload = {}) => request("/api/database-backups/settings", { method: "PATCH", body: JSON.stringify(payload || {}) }),
+    authUrl: () => request("/api/database-backups/google-drive/auth-url"),
+    disconnect: () => request("/api/database-backups/google-drive/disconnect", { method: "DELETE" }),
+    backupNow: () => request("/api/database-backups/backup-now", { method: "POST" }),
+    prepareRestore: (fileId) => request(`/api/database-backups/restore/${encodeURIComponent(fileId)}/prepare`, { method: "POST" }),
+    confirmRestore: (fileId, payload = {}) => request(`/api/database-backups/restore/${encodeURIComponent(fileId)}/confirm`, { method: "POST", body: JSON.stringify(payload || {}) }),
+  },
 
   tws: {
