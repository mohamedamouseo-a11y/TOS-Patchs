+    `### المهام المفتوحة${Number.isFinite(Number(taskListMeta.totalCount)) ? ` (${Number(taskListMeta.totalCount)})` : ""}`,
+  ];
+  if (!tasks.length) {
+    lines.push("لا توجد مهام مفتوحة ظاهرة في نطاق صلاحياتك لهذا المشروع.");
+    return lines.join("\n");
+  }
+  lines.push("| المهمة | الحالة | المسؤول | تاريخ التسليم | متأخرة |", "|---|---|---|---|---|");
+  const now = Date.now();
+  for (const task of tasks) {
+    const due = task?.dueDate ? new Date(task.dueDate) : null;
+    const overdue = due && !Number.isNaN(due.getTime()) && due.getTime() < now ? "نعم" : "لا";
+    lines.push(`| ${escapeMarkdownCell(task?.title || "—")} | ${escapeMarkdownCell(task?.status || "—")} | ${escapeMarkdownCell(taskAssigneeLabel(task))} | ${displayDate(task?.dueDate)} | ${overdue} |`);
+  }
+  if (taskListMeta.hasMore) {
+    lines.push("", `تم عرض ${Number(taskListMeta.returnedCount || tasks.length)} من ${Number(taskListMeta.totalCount || tasks.length)} مهمة مفتوحة. اطلب باقي المهام لاستكمال القائمة.`);
+  }
+  return lines.join("\n");
+}
