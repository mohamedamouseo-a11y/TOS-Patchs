+function escapeMarkdownCell(value) {
+  return String(value ?? "")
+    .replace(/\|/g, "\\|")
+    .replace(/\r?\n/g, " ")
+    .trim();
+}
+
+function displayDate(value) {
+  if (!value) return "—";
+  const date = new Date(value);
+  if (Number.isNaN(date.getTime())) return "—";
+  return date.toISOString().slice(0, 10);
+}
+
+function taskAssigneeLabel(task) {
+  const names = [
+    ...(Array.isArray(task?.assignees) ? task.assignees.map((item) => item?.name) : []),
+    task?.assignee?.name,
+  ].filter(Boolean);
+  return [...new Set(names)].join("، ") || "غير مسندة";
+}
+
+function buildDeterministicProjectResumeResponse({ selectionIndex, project, tasks = [], taskListMeta = {} }) {
+  if (!project?.name) return null;
+  const lines = [
+    `تم اختيار الخيار ${Number(selectionIndex || 0) + 1}: ${escapeMarkdownCell(project.name)}.`,
+    "",
+    "### تفاصيل المشروع",
+    `- **الحالة التشغيلية:** ${escapeMarkdownCell(project.status || "—")}`,
+    `- **المرحلة الحالية:** ${escapeMarkdownCell(project.stage || "—")}`,
+    `- **نسبة الإنجاز:** ${Number.isFinite(Number(project.progress)) ? `${Number(project.progress)}%` : "—"}`,
