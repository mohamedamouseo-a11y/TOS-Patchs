+  const source = String(metadata.source || metadata?.payload?.source || "").toUpperCase();
+  const eventType = String(metadata.eventType || metadata?.payload?.eventType || "").toLowerCase();
+  return source === "TCRM" && eventType === "comment.created";
+}
