+function compactBoardDescription(value, maxLength = 900) {
+  const raw = String(value || "");
+  if (!raw) return "";
+  const urls = [...new Set(raw.match(/https?:\/\/[^\s"'<>]+/gi) || [])].slice(0, 3);
+  const plain = raw
+    .replace(/<style[\s\S]*?<\/style>/gi, " ")
+    .replace(/<script[\s\S]*?<\/script>/gi, " ")
+    .replace(/<[^>]+>/g, " ")
+    .replace(/&nbsp;/gi, " ")
+    .replace(/&amp;/gi, "&")
+    .replace(/&lt;/gi, "<")
+    .replace(/&gt;/gi, ">")
+    .replace(/&quot;/gi, '"')
+    .replace(/&#39;/gi, "'")
+    .replace(/\s+/g, " ")
+    .trim();
+  const withUrls = [plain, ...urls.filter((url) => !plain.includes(url))].filter(Boolean).join(" ");
+  return withUrls.length > maxLength ? `${withUrls.slice(0, maxLength - 1).trimEnd()}…` : withUrls;
+}
+
+function compactBoardDesignRequest(value) {
+  if (!value || typeof value !== "object" || Array.isArray(value)) return value ? { present: true } : null;
+  return {
+    present: true,
+    requesterDepartment: value.requesterDepartment || null,
+    lifecycleStatus: value.lifecycleStatus || null,
+    requestType: value.requestType || value.type || null,
+    platform: value.platform || null,
+  };
+}
+
+function isTcrmReplyActivity(activity) {
+  const metadata = activity?.metadata && typeof activity.metadata === "object" && !Array.isArray(activity.metadata)
