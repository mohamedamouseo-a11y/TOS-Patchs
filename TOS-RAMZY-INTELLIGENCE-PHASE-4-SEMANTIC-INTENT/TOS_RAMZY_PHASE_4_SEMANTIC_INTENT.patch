+++ b/backend/src/agency-operator/services/semanticIntentResolver.service.js
@@ -0,0 +1,184 @@
+import { normalizeEntityText } from "./entityResolution.service.js";
+
+const SUPPORTED_PROPOSAL_OPERATIONS = new Set([
+  "CHANGE_ASSIGNEE",
+  "CHANGE_DUE_DATE",
+  "ADD_COMMENT",
+  "ADD_CHECKLIST",
+]);
+
+function matches(text, patterns) {
+  return patterns.some((pattern) => pattern.test(text));
+}
+
+function bounded(value, max = 120) {
+  return String(value || "").trim().replace(/\s+/g, " ").slice(0, max);
+}
+
+function addCandidate(candidates, intent, score, reason) {
+  const existing = candidates.find((item) => item.intent === intent);
+  if (!existing || score > existing.score) {
+    if (existing) Object.assign(existing, { score, reason });
+    else candidates.push({ intent, score, reason });
+  }
+}
+
+function detectAssigneeQuery(raw) {
+  const value = String(raw || "").trim();
+  const patterns = [
+    /(?:خلي|خلّي)\s+(.+?)\s+(?:يمسك|ياخد|يستلم)(?:\s|$)/iu,
+    /(?:اسند|إسند|assign|حوّل|حول|انقل)\s+(?:المهمة|المهمه|التاسك|task|دي|هذه|ها)?\s*(?:لـ?|لأ|لا|إلى|الى|to)\s*([^،,؟?!]+)/iu,
+    /(?:خليها|خليه|خلي دي|خلّيها|خلّيه)\s+(?:مع|على)\s+([^،,؟?!]+)/iu,
+    /(?:assign|give)\s+(?:this\s+)?(?:task\s+)?(?:to\s+)([^,?!]+)/iu,
+  ];
+  for (const pattern of patterns) {
+    const match = value.match(pattern);
+    if (!match?.[1]) continue;
+    const candidate = bounded(match[1], 80)
+      .split(/\s+(?:في|على\s+مشروع|project|بكره|بكرة|غدا|غدًا)\b/iu)[0]
+      .trim();
+    if (candidate) return candidate;
+  }
+  return null;
+}
+
+function detectStatus(text) {
+  if (matches(text, [/(?:^|\s)(?:done|مكتمل|مكتمله|خلص|منتهي|منتهيه)(?:\s|$)/iu])) return "DONE";
+  if (matches(text, [/(?:^|\s)(?:cancelled|canceled|ملغي|ملغيه|الغاء)(?:\s|$)/iu])) return "CANCELLED";
+  if (matches(text, [/(?:^|\s)(?:in progress|in_progress|شغال|شغاله|جاري|جاريه)(?:\s|$)/iu])) return "IN_PROGRESS";
+  if (matches(text, [/(?:^|\s)(?:waiting client|waiting_client|مستني العميل|مستنيه العميل)(?:\s|$)/iu])) return "WAITING_CLIENT";
+  if (matches(text, [/(?:^|\s)(?:in review|in_review|review|مراجعه)(?:\s|$)/iu])) return "IN_REVIEW";
+  if (matches(text, [/(?:^|\s)(?:approved|موافقه|معتمد|معتمده)(?:\s|$)/iu])) return "APPROVED";
+  if (matches(text, [/(?:^|\s)(?:todo|to do|مطلوب)(?:\s|$)/iu])) return "TODO";
+  if (matches(text, [/(?:^|\s)(?:backlog)(?:\s|$)/iu])) return "BACKLOG";
+  return null;
+}
+
+function detectPriority(text) {
+  if (matches(text, [/(?:^|\s)(?:urgent|عاجل|عاجله)(?:\s|$)/iu])) return "URGENT";
+  if (matches(text, [/(?:^|\s)(?:high|عالي|عاليه|مرتفع|مرتفعه)(?:\s|$)/iu])) return "HIGH";
+  if (matches(text, [/(?:^|\s)(?:medium|متوسط|متوسطه)(?:\s|$)/iu])) return "MEDIUM";
+  if (matches(text, [/(?:^|\s)(?:low|منخفض|منخفضه)(?:\s|$)/iu])) return "LOW";
+  return null;
+}
+
+function detectOperation(text, flags, context) {
+  const taskContext = flags.taskEntity || context.hasActiveTask || context.hasRecentTasks;
+  if (flags.assignAction && taskContext) return "CHANGE_ASSIGNEE";
+  if (flags.commentAction && taskContext) return "ADD_COMMENT";
+  if (flags.checklistAction && taskContext) return "ADD_CHECKLIST";
+  if (flags.dueAction && taskContext) return "CHANGE_DUE_DATE";
+  if (flags.priorityAction && taskContext) return "PRIORITY_CHANGE";
+  if (flags.statusAction && taskContext) return "STATUS_CHANGE";
+  if (flags.createAction && flags.taskEntity) return "CREATE_TASK";
+  if (flags.genericUpdate && taskContext) return "TASK_UPDATE";
+  return null;
+}
+
+export function resolveSemanticIntent({ message, context = {} } = {}) {
+  const text = normalizeEntityText(message);
+  const hasRecentTasks = Array.isArray(context.recentTasks) && context.recentTasks.length > 0;
+  const hasActiveTask = Boolean(context.activeTaskId);
+  const hasActiveProject = Boolean(context.activeProjectId);
+  const lastIntent = String(context.lastResolvedIntent || "");
+  const lastResultType = String(context.lastResultType || "");
+  const taskContext = hasActiveTask || hasRecentTasks || lastIntent.startsWith("TASK") || lastResultType.startsWith("TASK");
+
+  const flags = {
+    taskEntity: matches(text, [/(?:^|\s)(?:task|tasks|تاسك|التاسك|تاسكات|التاسكات|مهمه|المهمه|مهام|المهام)(?:\s|$)/iu]),
+    projectEntity: matches(text, [/(?:^|\s)(?:project|projects|مشروع|المشروع|مشاريع|المشاريع)(?:\s|$)/iu]),
+    userEntity: matches(text, [/(?:^|\s)(?:user|employee|assignee|مستخدم|المستخدم|موظف|الموظف|شخص)(?:\s|$)/iu]),
+    clientEntity: matches(text, [/(?:^|\s)(?:client|clients|account|عميل|العميل|عملاء|العملاء|حساب)(?:\s|$)/iu]),
+    createAction: matches(text, [/(?:^|\s)(?:create|make|اعمل|انشء|ضيف|اضف|حط)\s+(?:(?:لي|a|new|جديده)\s+)?(?:task|تاسك|التاسك|مهمه|المهمه)(?:\s|$)/iu, /(?:^|\s)(?:new|جديده)\s+(?:task|تاسك|التاسك|مهمه|المهمه)(?:\s|$)/iu, /(?:task|تاسك|التاسك|مهمه|المهمه)\s+(?:جديده|new)(?:\s|$)/iu]),
+    genericUpdate: matches(text, [/(?:^|\s)(?:غير|عدل|حدث|خلي|اسند|حول|حوّل|انقل|set|change|update|edit|move|assign)(?:\s|$)/iu]),
+    assignAction: matches(text, [/(?:خلي|خلّي)\s+.+?\s+(?:يمسك|ياخد|يستلم)/iu, /(?:^|\s)(?:اسند|assign)(?:\s|$)/iu, /(?:حول|حوّل|انقل).*(?:لأ|لا|لـ|الى|الي|to)/iu, /(?:خليها|خليه|خلي دي).*(?:مع|على)/iu]),
+    assigneeQuestion: matches(text, [/(?:مين|من)\s+(?:ماسك|مسؤول|مسءول)/iu, /(?:على مين|بتاع مين|بتاعه مين|assignee|assigned to|who owns|who is responsible)/iu]),
+    dueAction: matches(text, [/(?:اجل|اخر|أخر|قدم|غير|عدل|change|move|set).*(?:تسليم|موعد|ميعاد|due|deadline|تاريخ)/iu, /(?:خلي|خلّي).*(?:التسليم|الموعد|الميعاد|due|deadline)/iu]),
+    commentAction: matches(text, [/(?:ضيف|اضف|حط|اكتب|add|write).*(?:كومنت|تعليق|comment|note)/iu]),
+    checklistAction: matches(text, [/(?:ضيف|اضف|حط|add).*(?:checklist|تشيك ليست|check list)/iu]),
+    statusAction: matches(text, [/(?:غير|عدل|خلي|set|change|update).*(?:الحاله|حاله|status)/iu]),
+    priorityAction: matches(text, [/(?:غير|عدل|خلي|set|change|update).*(?:الاولويه|اولويه|priority)/iu]),
+    overdue: matches(text, [/(?:متاخر|متاخره|متاخرين|overdue|late|فات معاد|فات ميعاد|عدي معاد|عدى معاد|deadline missed)/iu]),
+    blocked: matches(text, [/(?:واقف|واقفه|متعطل|متعطله|متوقف|متوقفه|معلق|معلقه|blocked|stuck|waiting|مستني|مستنيه)/iu]),
+    details: matches(text, [/(?:تفاصيل|details|detail|افتح|open|كل حاجه|كل حاجة)/iu]),
+    listAction: matches(text, [/(?:^|\s)(?:هات|اعرض|وريني|جيب|طلع|show|list|find)(?:\s|$)/iu]),
+    summary: matches(text, [/(?:لخص|ملخص|summary|وضع|عامل ايه|حاله|health|progress|تقدم|نسبه الانجاز|خلص كام)/iu]),
+    team: matches(text, [/(?:فريق|team|اعضاء|members|مين شغال|مين عليه)/iu]),
+    help: matches(text, [/(?:مساعده|مساعدة|help|ازاي|كيف|تقدر تعمل ايه|what can you do)/iu]),
+    ordinalReference: matches(text, [/(?:^|\s)(?:اول|الاول|اولي|اولى|الاولى|تاني|تانيه|التاني|التانيه|الثاني|الثانيه|تالت|تالته|التالت|التالته|الثالث|الثالثه|رابع|رابعه|الرابع|الرابعه|خامس|خامسه|الخامس|الخامسه|اخر|الاخير|الاخيره|first|second|third|fourth|fifth|last|1st|2nd|3rd|4th|5th)(?:\s|$)/iu]),
+    setReference: matches(text, [/(?:المهام دي|التاسكات دي|دول|منهم|منها|فيهم|عليهم|these tasks|those tasks|them|among them)/iu]),
+  };
+
+  const semanticContext = { hasRecentTasks, hasActiveTask, hasActiveProject, taskContext };
+  const operation = detectOperation(text, flags, semanticContext);
+  const candidates = [];
+
+  if (flags.createAction && flags.taskEntity) addCandidate(candidates, "TASK_CREATE", 0.99, "TASK_CREATE_SEMANTICS");
+  if (operation && operation !== "CREATE_TASK" && (flags.taskEntity || taskContext || flags.ordinalReference || flags.setReference)) {
+    addCandidate(candidates, "TASK_UPDATE", operation === "TASK_UPDATE" ? 0.91 : 0.98, `TASK_OPERATION_${operation}`);
+  }
+  if (flags.overdue && (flags.taskEntity || hasRecentTasks || hasActiveProject || taskContext)) addCandidate(candidates, "TASK_OVERDUE", 0.97, "OVERDUE_TASK_SEMANTICS");
+  if (flags.blocked && (flags.taskEntity || hasRecentTasks || hasActiveProject || taskContext)) addCandidate(candidates, "TASK_BLOCKED", 0.96, "BLOCKED_TASK_SEMANTICS");
+  if (flags.assigneeQuestion && (flags.taskEntity || taskContext || flags.ordinalReference || flags.setReference)) addCandidate(candidates, "TASK_BY_ASSIGNEE", 0.97, "TASK_ASSIGNEE_SEMANTICS");
+  if (flags.details && (flags.taskEntity || taskContext || flags.ordinalReference || flags.setReference)) addCandidate(candidates, "TASK_DETAILS", 0.95, "TASK_DETAILS_SEMANTICS");
+  if (flags.ordinalReference && hasRecentTasks) addCandidate(candidates, "TASK_DETAILS", flags.details ? 0.98 : 0.92, "ORDINAL_TASK_FOLLOWUP");
+  if (flags.listAction && flags.taskEntity) addCandidate(candidates, "TASK_SEARCH", 0.95, "TASK_LIST_SEMANTICS");
+  if (flags.taskEntity) addCandidate(candidates, "TASK_SEARCH", 0.78, "TASK_ENTITY_DEFAULT");
+  if (flags.setReference && hasRecentTasks && !flags.overdue && !flags.blocked && !flags.details && !operation) addCandidate(candidates, "TASK_SEARCH", 0.86, "RECENT_TASK_SET_FOLLOWUP");
+
+  if (flags.projectEntity && flags.team) addCandidate(candidates, "PROJECT_TEAM", 0.98, "PROJECT_TEAM_SEMANTICS");
+  if (flags.projectEntity && flags.summary) addCandidate(candidates, "PROJECT_SUMMARY", 0.97, "PROJECT_SUMMARY_SEMANTICS");
+  if (flags.projectEntity) addCandidate(candidates, "PROJECT_LOOKUP", 0.88, "PROJECT_ENTITY_DEFAULT");
+  if (flags.clientEntity) addCandidate(candidates, "CLIENT_LOOKUP", 0.91, "CLIENT_LOOKUP_SEMANTICS");
+  if (flags.userEntity) addCandidate(candidates, "USER_LOOKUP", 0.9, "USER_LOOKUP_SEMANTICS");
+  if (flags.help) addCandidate(candidates, "SYSTEM_HELP", 0.96, "SYSTEM_HELP_SEMANTICS");
+
+  if (!candidates.length && hasRecentTasks && flags.ordinalReference) addCandidate(candidates, "TASK_DETAILS", 0.88, "CONTEXTUAL_ORDINAL_ONLY");
+  if (!candidates.length && hasActiveProject && flags.listAction && taskContext) addCandidate(candidates, "TASK_SEARCH", 0.74, "CONTEXTUAL_TASK_LIST");
+  if (!candidates.length) addCandidate(candidates, "GENERAL", 0.35, "NO_OPERATIONAL_INTENT");
+
+  candidates.sort((a, b) => b.score - a.score);
+  const top = candidates[0];
+  const second = candidates[1] || null;
+  const assigneeQuery = operation === "CHANGE_ASSIGNEE" ? detectAssigneeQuery(message) : null;
+  const statusValue = detectStatus(text);
+  const priorityValue = detectPriority(text);
+  const actionCapability = operation
+    ? SUPPORTED_PROPOSAL_OPERATIONS.has(operation)
+      ? "PROPOSAL_SUPPORTED"
+      : "INTENT_ONLY"
+    : null;
+
+  const signals = Object.entries(flags).filter(([, enabled]) => enabled).map(([name]) => name);
+  return {
+    version: "RAMZY_SEMANTIC_INTENT_V1",
+    intent: top.intent,
+    confidence: top.score,
+    reason: top.reason,
+    domain: top.intent.startsWith("TASK") ? "TASK" : top.intent.startsWith("PROJECT") ? "PROJECT" : top.intent.startsWith("USER") ? "USER" : top.intent.startsWith("CLIENT") ? "CLIENT" : top.intent === "SYSTEM_HELP" ? "SYSTEM" : "GENERAL",
+    operation,
+    actionCapability,
+    slots: {
+      assigneeQuery,
+      statusValue,
+      priorityValue,
+    },
+    signals,
+    alternatives: candidates.slice(1, 4),
+    ambiguous: Boolean(second && top.score < 0.9 && top.score - second.score < 0.08),
+    contextUsed: Boolean(!flags.taskEntity && taskContext && top.intent.startsWith("TASK")),
+  };
+}
+
+export function classifySemanticIntent(message, context = {}) {
+  return resolveSemanticIntent({ message, context }).intent;
+}
+
+export function getSemanticIntentConfig() {
+  return {
+    version: "RAMZY_SEMANTIC_INTENT_V1",
+    mode: "DETERMINISTIC_CONCEPT_COMPOSITION",
+    providerCalls: 0,
+    supportedProposalOperations: [...SUPPORTED_PROPOSAL_OPERATIONS],
+  };
+}
