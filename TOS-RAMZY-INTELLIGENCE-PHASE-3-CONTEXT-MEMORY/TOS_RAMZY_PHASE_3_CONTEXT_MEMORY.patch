@@ -0,0 +1,178 @@
+import { normalizeEntityText } from "./entityResolution.service.js";
+
+const TASK_CONTEXT_INTENTS = new Set([
+  "TASK_SEARCH",
+  "TASK_DETAILS",
+  "TASK_OVERDUE",
+  "TASK_BLOCKED",
+  "TASK_BY_ASSIGNEE",
+  "TASK_CREATE",
+  "TASK_UPDATE",
+]);
+
+function compactRecentTasks(value) {
+  if (!Array.isArray(value)) return [];
+  return value
+    .filter((item) => item?.id)
+    .slice(0, 15)
+    .map((item) => ({
+      id: item.id,
+      title: String(item.title || item.name || "").slice(0, 240),
+      status: item.status || null,
+      projectId: item.projectId || item.project?.id || null,
+    }));
+}
+
+function ordinalIndex(text, count) {
+  const rules = [
+    { index: 0, pattern: /(?:^|\s)(?:اول|الاول|الأول|اولي|اولى|الأولى|first|1st)(?:\s|$)/iu },
+    { index: 1, pattern: /(?:^|\s)(?:تاني|تانيه|تانية|الثاني|الثانيه|الثانية|second|2nd)(?:\s|$)/iu },
+    { index: 2, pattern: /(?:^|\s)(?:تالت|تالته|تالتة|الثالث|الثالثه|الثالثة|third|3rd)(?:\s|$)/iu },
+    { index: 3, pattern: /(?:^|\s)(?:رابع|رابعه|رابعة|الرابع|الرابعه|الرابعة|fourth|4th)(?:\s|$)/iu },
+    { index: 4, pattern: /(?:^|\s)(?:خامس|خامسه|خامسة|الخامس|الخامسه|الخامسة|fifth|5th)(?:\s|$)/iu },
+  ];
+  for (const rule of rules) {
+    if (rule.pattern.test(text)) return rule.index < count ? rule.index : null;
+  }
+  if (/(?:اخر|آخر|الاخير|الأخير|الاخيره|الأخيرة|last)(?:\s|$)/iu.test(text)) return count ? count - 1 : null;
+  return null;
+}
+
+export function resolveContextReference({
+  requestText,
+  detectedIntent,
+  previous = {},
+  explicitProjectMention = false,
+  conversationProjectId = null,
+} = {}) {
+  const text = normalizeEntityText(requestText);
+  const recentTasks = compactRecentTasks(previous.recentTasks);
+  const activeProjectId = previous.activeProjectId || conversationProjectId || null;
+  const activeUserId = previous.activeUserId || null;
+  const taskIntent = TASK_CONTEXT_INTENTS.has(detectedIntent);
+
+  const projectReferenceMarker = /(?:نفس المشروع|المشروع ده|المشروع دا|المشروع الحالي|عليه|فيه|same project|that project|current project|there)/iu.test(text);
+  const recentTaskMarker = /(?:المهام دي|التاسكات دي|دول|دي|منهم|منها|فيهم|عليهم|these tasks|those tasks|them|among them)/iu.test(text);
+  const userReferenceMarker = /(?:بتاعه|بتاعها|عنده|عندها|له|لها|معاه|معاها|نفس الموظف|نفس المستخدم|same user|same employee|his|her)/iu.test(text);
+  const index = ordinalIndex(text, recentTasks.length);
+  const referencedTask = index !== null ? recentTasks[index] : null;
+
+  const useActiveProject = Boolean(
+    !explicitProjectMention
+    && activeProjectId
+    && (taskIntent || projectReferenceMarker)
+  );
+  const useRecentTaskSet = Boolean(
+    taskIntent
+    && recentTasks.length
+    && (recentTaskMarker || referencedTask)
+  );
+  const useActiveUser = Boolean(activeUserId && userReferenceMarker && taskIntent);
+
+  return {
+    version: "RAMZY_CONTEXT_RESOLUTION_V1",
+    useActiveProject,
+    activeProjectId: useActiveProject ? activeProjectId : null,
+    useActiveUser,
+    activeUserId: useActiveUser ? activeUserId : null,
+    useRecentTaskSet,
+    recentTaskIds: useRecentTaskSet ? recentTasks.map((item) => item.id) : [],
+    referencedTaskId: referencedTask?.id || null,
+    referencedTaskIndex: index,
+    referenceReason: referencedTask
+      ? "ORDINAL_TASK_REFERENCE"
+      : useRecentTaskSet
+        ? "RECENT_TASK_SET_REFERENCE"
+        : useActiveUser
+          ? "ACTIVE_USER_REFERENCE"
+          : useActiveProject
+            ? "ACTIVE_PROJECT_REFERENCE"
+            : "NONE",
+  };
+}
+
+function resultType(live, previous) {
+  if (Object.prototype.hasOwnProperty.call(live || {}, "tasks")) return "TASK_LIST";
+  if (live?.task) return "TASK";
+  if (live?.project) return "PROJECT";
+  if (Array.isArray(live?.users)) return "USER_LIST";
+  if (Array.isArray(live?.clients)) return "CLIENT_LIST";
+  return previous.lastResultType || null;
+}
+
+export function buildNextConversationContext({
+  previous = {},
+  project = null,
+  conversationProjectId = null,
+  assignee = null,
+  live = {},
+  detectedIntent,
+  clarificationRequired = false,
+  contextResolution = {},
+} = {}) {
+  const previousRecentTasks = compactRecentTasks(previous.recentTasks);
+  const resolvedProjectId = project?.id
+    || (contextResolution.useActiveProject ? contextResolution.activeProjectId : null)
+    || conversationProjectId
+    || previous.activeProjectId
+    || null;
+  const projectChanged = Boolean(project?.id && previous.activeProjectId && project.id !== previous.activeProjectId);
+
+  let recentTasks = projectChanged || clarificationRequired ? [] : previousRecentTasks;
+  if (Object.prototype.hasOwnProperty.call(live || {}, "tasks")) {
+    recentTasks = compactRecentTasks(live.tasks);
+  } else if (live?.task?.id) {
+    recentTasks = compactRecentTasks([live.task]);
+  }
+
+  const referencedTask = contextResolution.referencedTaskId
+    ? recentTasks.find((item) => item.id === contextResolution.referencedTaskId)
+      || previousRecentTasks.find((item) => item.id === contextResolution.referencedTaskId)
+    : null;
+  const singleTask = recentTasks.length === 1 ? recentTasks[0] : null;
+  const activeTask = live?.task?.id ? live.task : referencedTask || singleTask;
+
+  return {
+    contextVersion: "RAMZY_CONTEXT_MEMORY_V1",
+    activeProjectId: clarificationRequired ? null : resolvedProjectId,
+    activeProjectName: clarificationRequired ? null : (project?.name || (projectChanged ? null : previous.activeProjectName) || null),
+    activeClientId: clarificationRequired ? null : (project?.clientId || (projectChanged ? null : previous.activeClientId) || null),
+    activeTaskId: clarificationRequired ? null : (activeTask?.id || (projectChanged ? null : previous.activeTaskId) || null),
+    activeTaskTitle: clarificationRequired ? null : (activeTask?.title || activeTask?.name || (projectChanged ? null : previous.activeTaskTitle) || null),
+    activeUserId: clarificationRequired ? null : (assignee?.id || (projectChanged ? null : previous.activeUserId) || null),
+    activeUserName: clarificationRequired ? null : (assignee?.name || (projectChanged ? null : previous.activeUserName) || null),
+    recentTasks: clarificationRequired ? [] : recentTasks,
+    recentTaskIds: clarificationRequired ? [] : recentTasks.map((item) => item.id),
+    lastResultType: clarificationRequired ? null : resultType(live, previous),
+    lastResolvedIntent: detectedIntent,
+  };
+}
+
+export function getContextResolutionConfig() {
+  return {
+    version: "RAMZY_CONTEXT_MEMORY_V1",
+    scope: "CONVERSATION_ONLY",
+    maxRecentTasks: 15,
+    supports: ["ACTIVE_PROJECT", "ACTIVE_USER", "RECENT_TASK_SET", "ORDINAL_TASK_REFERENCE"],
+  };
+}
